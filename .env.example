# Copy to .env.local (gitignored). Local-only values that never leave this
# machine; CI uses GitHub Actions variables and secrets instead.

# Folder of your own disc images (.bin/.cue, .chd, .iso) for the local-only
# `library` test preset. Local only: CI never sees a disc image.
SCHWAYSTATION_DISC_DIR=

# Folder holding your own PlayStation BIOS dumps (SCPH-xxxx .bin), which the
# core needs to boot. Local only: no BIOS bytes are ever committed or sent to CI.
SCHWAYSTATION_BIOS_DIR=
