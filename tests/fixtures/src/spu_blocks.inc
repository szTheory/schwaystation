; Authored PS1 SPU BRR blocks. Each packed sample nibble is generated by an
; integer expression so the source contains no captured audio or executable bytes.
.macro spu_brr_block,flags,seed
  .byte 0x04, flags
  .byte (((seed + 0) & 0x0F) << 4) | ((seed + 1) & 0x0F)
  .byte (((seed + 2) & 0x0F) << 4) | ((seed + 3) & 0x0F)
  .byte (((seed + 4) & 0x0F) << 4) | ((seed + 5) & 0x0F)
  .byte (((seed + 6) & 0x0F) << 4) | ((seed + 7) & 0x0F)
  .byte (((seed + 8) & 0x0F) << 4) | ((seed + 9) & 0x0F)
  .byte (((seed + 10) & 0x0F) << 4) | ((seed + 11) & 0x0F)
  .byte (((seed + 12) & 0x0F) << 4) | ((seed + 13) & 0x0F)
  .byte (((seed + 14) & 0x0F) << 4) | ((seed + 15) & 0x0F)
  .byte (((seed + 16) & 0x0F) << 4) | ((seed + 17) & 0x0F)
  .byte (((seed + 18) & 0x0F) << 4) | ((seed + 19) & 0x0F)
  .byte (((seed + 20) & 0x0F) << 4) | ((seed + 21) & 0x0F)
  .byte (((seed + 22) & 0x0F) << 4) | ((seed + 23) & 0x0F)
  .byte (((seed + 24) & 0x0F) << 4) | ((seed + 25) & 0x0F)
  .byte (((seed + 26) & 0x0F) << 4) | ((seed + 27) & 0x0F)
.endmacro

.align 4
spu_brr_blocks:
  spu_brr_block 0x07, 1
  spu_brr_block 0x07, 4
spu_brr_blocks_end:
