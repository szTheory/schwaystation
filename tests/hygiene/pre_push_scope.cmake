cmake_minimum_required(VERSION 3.25)
find_package(Git REQUIRED)
file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}/scripts" "${ROOT}/.githooks")
file(COPY "${SOURCE}/scripts/hygiene.sh" DESTINATION "${ROOT}/scripts")
file(COPY "${SOURCE}/.githooks/pre-push" DESTINATION "${ROOT}/.githooks")
function(hygiene_git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "pre-push fixture git ${ARGN} failed: ${error}")
  endif()
  set(GIT_OUTPUT "${output}" PARENT_SCOPE)
endfunction()
hygiene_git(init -q)
hygiene_git(config user.name Fixture)
hygiene_git(config user.email fixture@users.noreply.github.com)
file(WRITE "${ROOT}/base.txt" "clean base\n")
hygiene_git(add base.txt)
hygiene_git(commit -qm base)
hygiene_git(branch unrelated)
hygiene_git(update-ref refs/remotes/origin/main HEAD)
hygiene_git(switch unrelated)
set(home_prefix "/Use")
string(APPEND home_prefix "rs/someone/")
file(WRITE "${ROOT}/unrelated.txt" "${home_prefix}unrelated\n")
hygiene_git(add unrelated.txt)
hygiene_git(commit -qm unrelated)
hygiene_git(switch -c pushed refs/remotes/origin/main)
file(WRITE "${ROOT}/pushed.txt" "clean pushed commit\n")
hygiene_git(add pushed.txt)
hygiene_git(commit -qm pushed)
hygiene_git(rev-parse HEAD)
string(STRIP "${GIT_OUTPUT}" pushed_sha)
string(REPEAT "0" 40 zero_sha)
file(WRITE "${ROOT}/hook-input" "refs/heads/pushed ${pushed_sha} refs/heads/pushed ${zero_sha}\n")
execute_process(COMMAND "${SHELL}" "${ROOT}/.githooks/pre-push" INPUT_FILE "${ROOT}/hook-input"
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "pre-push scanned unrelated history or rejected a clean pushed ref: ${error}")
endif()
file(WRITE "${ROOT}/pushed.txt" "${home_prefix}pushed\n")
hygiene_git(add pushed.txt)
hygiene_git(commit -qm unsafe-pushed)
hygiene_git(rev-parse HEAD)
string(STRIP "${GIT_OUTPUT}" pushed_sha)
file(WRITE "${ROOT}/hook-input" "refs/heads/pushed ${pushed_sha} refs/heads/pushed ${zero_sha}\n")
execute_process(COMMAND "${SHELL}" "${ROOT}/.githooks/pre-push" INPUT_FILE "${ROOT}/hook-input"
  WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(rc EQUAL 0 OR NOT error MATCHES "hygiene: home directory path: commit")
  message(FATAL_ERROR "pre-push failed to reject unsafe pushed history: ${output}${error}")
endif()
