cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED WORK_ROOT OR NOT DEFINED CASE)
  message(FATAL_ERROR "SOURCE_ROOT, WORK_ROOT and CASE are required")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef suffix)
set(work "${WORK_ROOT}/compat-controls-${suffix}")
file(MAKE_DIRECTORY "${work}")
set(header "serial,md5,track1_sha1,title,region,media,predicate,status,evidence,date")
set(serial "fixture/control")
set(md5 "00000000000000000000000000000000")
set(predicate "frame@60=aaaaaaaa")
set(row_pass "${serial},${md5},-,Control,ntsc-u,exe,${predicate},pass,fixtures.control:exit=0,2026-11-11")
set(row_fail "${serial},${md5},-,Control,ntsc-u,exe,${predicate},fail,fixtures.control:exit=1,2026-11-11")
set(row_unknown "${serial},${md5},-,Control,ntsc-u,exe,${predicate},unknown,fixtures.control:exit=77,2026-11-11")
set(today "2026-11-11")
set(empty_allow "${work}/empty.allow")
file(WRITE "${empty_allow}" "# temporary test allowances\n")

function(write_ledger path rows)
  file(WRITE "${path}" "${header}\n${rows}\n")
endfunction()

function(expect_judge name candidate fresh prior allow expected)
  execute_process(
    COMMAND sh "${SOURCE_ROOT}/scripts/compat-ratchet.sh"
      "${candidate}" "${fresh}" "${prior}" "${allow}" "${today}"
    RESULT_VARIABLE result
    OUTPUT_QUIET ERROR_QUIET)
  if(expected AND NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name}: expected acceptance, got ${result}")
  elseif(NOT expected AND "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name}: invalid compatibility result was accepted")
  endif()
endfunction()

function(expect_doc name ledger output mode expected)
  execute_process(COMMAND sh "${SOURCE_ROOT}/scripts/compat-doc.sh" "${ledger}" "${output}" "${mode}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(expected AND NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "compatibility docs ${name}: expected success, got ${result}")
  elseif(NOT expected AND "${result}" STREQUAL "0")
    message(FATAL_ERROR "compatibility docs ${name}: invalid input was accepted")
  endif()
endfunction()

if(CASE STREQUAL "ratchet")
  set(base "${work}/base.csv")
  set(candidate "${work}/candidate.csv")
  set(fresh "${work}/fresh.csv")
  set(other "fixture/other,11111111111111111111111111111111,-,Other,pal,exe,boots@10,pass,fixtures.other:exit=0,2026-11-11")
  write_ledger("${base}" "${row_pass}")
  write_ledger("${candidate}" "${row_pass}")
  write_ledger("${fresh}" "${row_pass}")
  expect_judge("unchanged pass" "${candidate}" "${fresh}" "${base}" "${empty_allow}" TRUE)

  write_ledger("${candidate}" "${row_fail}")
  write_ledger("${fresh}" "${row_fail}")
  expect_judge("pass to fail" "${candidate}" "${fresh}" "${base}" "${empty_allow}" FALSE)
  write_ledger("${candidate}" "${row_unknown}")
  write_ledger("${fresh}" "${row_unknown}")
  expect_judge("pass to unknown" "${candidate}" "${fresh}" "${base}" "${empty_allow}" FALSE)

  write_ledger("${base}" "${row_unknown}")
  write_ledger("${candidate}" "${row_pass}")
  write_ledger("${fresh}" "${row_pass}")
  expect_judge("unknown to pass" "${candidate}" "${fresh}" "${base}" "${empty_allow}" TRUE)
  write_ledger("${candidate}" "${row_fail}")
  write_ledger("${fresh}" "${row_fail}")
  expect_judge("unknown to fail" "${candidate}" "${fresh}" "${base}" "${empty_allow}" TRUE)
  write_ledger("${candidate}" "${row_unknown}")
  write_ledger("${fresh}" "${row_unknown}")
  expect_judge("unknown to unknown" "${candidate}" "${fresh}" "${base}" "${empty_allow}" TRUE)
  write_ledger("${candidate}" "${row_pass}")
  write_ledger("${fresh}" "${row_pass}")
  write_ledger("${base}" "${row_fail}")
  expect_judge("fail to pass" "${candidate}" "${fresh}" "${base}" "${empty_allow}" TRUE)

  set(allow "${work}/allow.txt")
  file(WRITE "${allow}" "2026-09-12 ${serial} ${md5} ${predicate} behavior-rev=4 expires=2026-11-11 approved measured correction\n")
  write_ledger("${base}" "${row_pass}")
  write_ledger("${candidate}" "${row_fail}")
  write_ledger("${fresh}" "${row_fail}")
  expect_judge("60-day allowance boundary" "${candidate}" "${fresh}" "${base}" "${allow}" TRUE)
  file(WRITE "${allow}" "2026-09-01 ${serial} ${md5} ${predicate} behavior-rev=4 expires=2026-11-01 approved too-long window\n")
  expect_judge("61-day allowance rejected" "${candidate}" "${fresh}" "${base}" "${allow}" FALSE)
  file(WRITE "${allow}" "2026-09-01 ${serial} ${md5} ${predicate} behavior-rev=4 expires=2026-10-31 approved expired window\n")
  expect_judge("expired allowance rejected" "${candidate}" "${fresh}" "${base}" "${allow}" FALSE)
  file(WRITE "${allow}" "2026-09-12 ${serial} ${md5} ${predicate} behavior-rev=3 expires=2026-11-11 wrong revision\n")
  expect_judge("wrong behavior revision rejected" "${candidate}" "${fresh}" "${base}" "${allow}" FALSE)

  write_ledger("${base}" "${row_pass}")
  write_ledger("${candidate}" "${other}")
  write_ledger("${fresh}" "${other}")
  expect_judge("removed prior pass rejected" "${candidate}" "${fresh}" "${base}" "${empty_allow}" FALSE)

  write_ledger("${candidate}" "${row_pass}")
  write_ledger("${fresh}" "${other}")
  expect_judge("missing fresh row rejected" "${candidate}" "${fresh}" "" "${empty_allow}" FALSE)
  write_ledger("${fresh}" "${row_pass}\n${other}")
  expect_judge("extra fresh row rejected" "${candidate}" "${fresh}" "" "${empty_allow}" FALSE)
  write_ledger("${fresh}" "${row_fail}")
  expect_judge("fresh status disagreement rejected" "${candidate}" "${fresh}" "" "${empty_allow}" FALSE)

  set(changed_predicate "frame@60=bbbbbbbb")
  set(changed_pass "${serial},${md5},-,Control,ntsc-u,exe,${changed_predicate},pass,fixtures.control:exit=0,2026-11-11")
  write_ledger("${base}" "${row_pass}")
  write_ledger("${candidate}" "${changed_pass}")
  write_ledger("${fresh}" "${changed_pass}")
  expect_judge("changed passing frame hash rejected" "${candidate}" "${fresh}" "${base}" "${empty_allow}" FALSE)
  file(WRITE "${allow}" "2026-09-12 ${serial} ${md5} ${predicate} behavior-rev=4 expires=2026-11-11 approved measured correction\n")
  expect_judge("changed frame hash allowance" "${candidate}" "${fresh}" "${base}" "${allow}" TRUE)

  write_ledger("${candidate}" "${row_pass}\n${row_pass}")
  expect_judge("duplicate key rejected" "${candidate}" "${fresh}" "" "${empty_allow}" FALSE)
  write_ledger("${candidate}" "${serial},${md5},-,Bad,Comma,ntsc-u,exe,${predicate},pass,evidence,2026-11-11")
  expect_judge("comma field rejected" "${candidate}" "${candidate}" "" "${empty_allow}" FALSE)
  write_ledger("${candidate}" "${serial},${md5},-,Bad\"Quote,ntsc-u,exe,${predicate},pass,evidence,2026-11-11")
  expect_judge("quote field rejected" "${candidate}" "${candidate}" "" "${empty_allow}" FALSE)
  write_ledger("${candidate}" "${row_pass}\nBad\nField")
  expect_judge("newline field rejected" "${candidate}" "${candidate}" "" "${empty_allow}" FALSE)
  message(STATUS "compatibility: transition, allowance, fresh-result and field controls passed")
elseif(CASE STREQUAL "docs")
  set(ledger "${work}/ledger.csv")
  set(output "${work}/compatibility.md")
  set(alpha "fixture/alpha,22222222222222222222222222222222,-,Alpha,ntsc-u,exe,boots@10,pass,fixtures.alpha:exit=0,2026-11-11")
  set(zulu "fixture/zulu,33333333333333333333333333333333,-,Zulu,pal,bios,frame@10=cccc,unknown,built.zulu:exit=0,2026-11-10")
  write_ledger("${ledger}" "${zulu}\n${alpha}")
  expect_doc("generation" "${ledger}" "${output}" write TRUE)
  expect_doc("freshness" "${ledger}" "${output}" --check TRUE)
  file(READ "${output}" generated)
  string(FIND "${generated}" "| Alpha |" alpha_position)
  string(FIND "${generated}" "| Zulu |" zulu_position)
  if(alpha_position LESS 0 OR zulu_position LESS 0 OR NOT alpha_position LESS zulu_position OR
     NOT generated MATCHES "measured fixture" OR NOT generated MATCHES "fixtures.alpha:exit=0" OR
     NOT generated MATCHES "2026-11-11")
    message(FATAL_ERROR "generated docs are missing stable order, confidence, evidence or date")
  endif()
  file(APPEND "${output}" "\nStale output\n")
  expect_doc("stale output" "${ledger}" "${output}" --check FALSE)
  file(READ "${ledger}" valid_ledger)
  string(REPLACE "Alpha" "Bad,Title" invalid_ledger "${valid_ledger}")
  set(bad "${work}/invalid.csv")
  file(WRITE "${bad}" "${invalid_ledger}")
  expect_doc("comma field" "${bad}" "${output}" --check FALSE)
  string(REPLACE "Alpha" "Bad\"Title" invalid_ledger "${valid_ledger}")
  file(WRITE "${bad}" "${invalid_ledger}")
  expect_doc("quoted field" "${bad}" "${output}" --check FALSE)
  message(STATUS "compatibility: documentation freshness and field controls passed")
else()
  message(FATAL_ERROR "unknown compatibility control case '${CASE}'")
endif()

file(REMOVE_RECURSE "${work}")
