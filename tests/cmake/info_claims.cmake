# cmake -DINFO_FILE=<generated.info> -DINVENTORY=<inventory.txt> -P info_claims.cmake
# Fault prevented: a true functional .info claim with no gating host test.
cmake_minimum_required(VERSION 3.25)

foreach(required INFO_FILE INVENTORY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "info_claims: -D${required} is required")
  endif()
  if(NOT EXISTS "${${required}}")
    message(FATAL_ERROR "info_claims: ${required} does not exist")
  endif()
endforeach()

file(STRINGS "${INFO_FILE}" info_lines)
file(STRINGS "${INVENTORY}" inventory_lines)

function(info_value key output)
  set(found FALSE)
  foreach(line IN LISTS info_lines)
    if(line MATCHES "^${key} = \"([^\"]*)\"$")
      if(found)
        message(FATAL_ERROR "info_claims: duplicate .info key ${key}")
      endif()
      set(found TRUE)
      set(value "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "info_claims: missing .info key ${key}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(require_test name claim)
  string(REPLACE "." "\\." escaped_name "${name}")
  foreach(row IN LISTS inventory_lines)
    if(row MATCHES "^${escaped_name}[ \t]")
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "info_claims: ${claim} has no inventory test ${name}")
endfunction()

function(require_value key expected reason)
  info_value(${key} value)
  if(NOT value STREQUAL expected)
    message(FATAL_ERROR "info_claims: ${reason}")
  endif()
endfunction()

require_value(is_experimental true "keep experimental true until v2.0")
require_value(supported_extensions "exe|psexe" "only PS-EXE extensions are supported")
foreach(test IN ITEMS libretro.host libretro.content.no_bios libretro.content.psexe)
  require_test(${test} supported_extensions)
endforeach()
require_value(needs_fullpath true "PS-EXE content requires a full path")
require_value(supports_no_game true "supports_no_game must stay true")
require_value(core_options true "core_options must stay true")
foreach(claim IN ITEMS input_descriptors memory_descriptors)
  info_value(${claim} value)
  if(NOT value MATCHES "^(true|false)$")
    message(FATAL_ERROR "info_claims: ${claim} must be a boolean string")
  endif()
endforeach()
require_value(input_descriptors true "input_descriptors must stay true")
require_value(memory_descriptors true "memory_descriptors must stay true")
foreach(unsupported IN ITEMS disk_control cheats savestate libretro_saves load_subsystem)
  require_value(${unsupported} false "unsupported ${unsupported} claim must remain false")
endforeach()

foreach(line IN LISTS info_lines)
  if(line MATCHES "^([a-z_]+) = \"true\"$")
    set(claim "${CMAKE_MATCH_1}")
    if(claim STREQUAL "is_experimental")
      continue()
    elseif(claim STREQUAL "supports_no_game")
      set(required_tests libretro.host libretro.host.pal)
    elseif(claim STREQUAL "core_options")
      set(required_tests libretro.host libretro.host.pal)
    elseif(claim STREQUAL "input_descriptors")
      set(required_tests libretro.input.descriptors)
    elseif(claim STREQUAL "memory_descriptors")
      set(required_tests libretro.memory.aliases libretro.memory.boundaries)
    elseif(claim STREQUAL "needs_fullpath")
      set(required_tests libretro.content.no_bios libretro.content.psexe libretro.content.lifecycle)
    elseif(claim STREQUAL "disk_control")
      message(FATAL_ERROR "info_claims: disk_control must remain false until phase 6")
    else()
      message(FATAL_ERROR "info_claims: no test mapping for true .info claim ${claim}")
    endif()
    foreach(test IN LISTS required_tests)
      require_test("${test}" "${claim}")
    endforeach()
  endif()
endforeach()

message(STATUS "info_claims: true functional claims map to registered host tests")
