# cmake -DBIOS_TABLE=<table> [-DTRACKED=1 -DROOT=<tree>] [-DZIPS=<glob-or-list>] -P firmware_scan.cmake
# Fault prevented: retail BIOS digests entering tracked files or release archives.
cmake_minimum_required(VERSION 3.25)

macro(scan_fail text)
  if(DEFINED work AND EXISTS "${work}")
    file(REMOVE_RECURSE "${work}")
  endif()
  message(FATAL_ERROR "${text}")
endmacro()

if(NOT DEFINED BIOS_TABLE OR "${BIOS_TABLE}" STREQUAL "" OR NOT EXISTS "${BIOS_TABLE}")
  scan_fail("firmware_scan: -DBIOS_TABLE must name the BIOS digest table")
endif()

# Read the production MD5/SHA-1 pairs from the same table the core uses.
file(READ "${BIOS_TABLE}" table)
string(REPLACE "\n" " " table "${table}")
string(REGEX MATCHALL "\\{\\{[^}]*\\},[ \t]*\\{[^}]*\\}" rows "${table}")
file(STRINGS "${BIOS_TABLE}" table_lines)
set(source_rows 0)
foreach(line IN LISTS table_lines)
  if(line MATCHES "^[ \t]*\\{\\{")
    math(EXPR source_rows "${source_rows} + 1")
  endif()
endforeach()
list(LENGTH rows row_count)
if(row_count EQUAL 0 OR NOT row_count EQUAL source_rows)
  scan_fail("firmware_scan: BIOS digest table has missing or malformed rows")
endif()

foreach(row IN LISTS rows)
  string(REGEX MATCHALL "0x[0-9a-fA-F][0-9a-fA-F]u?" bytes "${row}")
  list(LENGTH bytes byte_count)
  if(NOT byte_count EQUAL 36)
    scan_fail("firmware_scan: BIOS digest table row has an invalid byte count")
  endif()
  list(SUBLIST bytes 0 16 md5_bytes)
  list(SUBLIST bytes 16 20 sha1_bytes)
  set(md5 "")
  foreach(byte IN LISTS md5_bytes)
    string(REGEX REPLACE "^0x" "" hex "${byte}")
    string(REGEX REPLACE "u$" "" hex "${hex}")
    string(TOLOWER "${hex}" hex)
    string(APPEND md5 "${hex}")
  endforeach()
  set(sha1 "")
  foreach(byte IN LISTS sha1_bytes)
    string(REGEX REPLACE "^0x" "" hex "${byte}")
    string(REGEX REPLACE "u$" "" hex "${hex}")
    string(TOLOWER "${hex}" hex)
    string(APPEND sha1 "${hex}")
  endforeach()
  set(bios_md5_${md5} TRUE)
  set(bios_sha1_${sha1} TRUE)
endforeach()

if(NOT TRACKED AND (NOT DEFINED ZIPS OR "${ZIPS}" STREQUAL ""))
  scan_fail("firmware_scan: provide -DTRACKED=1 and/or -DZIPS=<glob-or-list>")
endif()
if(TRACKED AND ("${ROOT}" STREQUAL "" OR NOT IS_DIRECTORY "${ROOT}"))
  scan_fail("firmware_scan: -DROOT must name a tracked-file tree")
endif()

# Keep extraction output outside the tree and every input archive directory.
set(tmp "$ENV{TMPDIR}")
foreach(env TEMP TMP)
  if(tmp STREQUAL "" AND NOT "$ENV{${env}}" STREQUAL "")
    set(tmp "$ENV{${env}}")
  endif()
endforeach()
if(tmp STREQUAL "")
  set(tmp /tmp)
endif()
file(TO_CMAKE_PATH "${tmp}" tmp)
string(REGEX REPLACE "/+$" "" tmp "${tmp}")
if(tmp STREQUAL "")
  set(tmp /)
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(work "${tmp}/schwaystation-firmware-scan-${id}")
file(MAKE_DIRECTORY "${work}")

function(scan_file path label)
  file(MD5 "${path}" md5)
  file(SHA1 "${path}" sha1)
  string(TOLOWER "${md5}" md5)
  string(TOLOWER "${sha1}" sha1)
  set(matches "")
  if(DEFINED bios_md5_${md5})
    list(APPEND matches MD5)
  endif()
  if(DEFINED bios_sha1_${sha1})
    list(APPEND matches SHA-1)
  endif()
  if(matches)
    list(JOIN matches " and " algorithms)
    set(file_matches "${found}")
    list(APPEND file_matches "${label}: matches listed BIOS ${algorithms} digest")
    set(found "${file_matches}" PARENT_SCOPE)
  else()
    set(found "${found}" PARENT_SCOPE)
  endif()
endfunction()

set(found "")
set(tracked_count 0)
set(archive_count 0)
if(TRACKED)
  file(REAL_PATH "${ROOT}" root_real)
  cmake_path(IS_PREFIX root_real "${work}" NORMALIZE temp_in_root)
  if(temp_in_root)
    scan_fail("firmware_scan: extraction temporary directory is inside the tracked tree")
  endif()
  if(DEFINED GIT AND NOT "${GIT}" STREQUAL "")
    set(git_command "${GIT}")
  else()
    find_program(git_command git REQUIRED)
  endif()
  execute_process(
    COMMAND "${git_command}" -C "${ROOT}" -c core.quotePath=false ls-files --cached
    RESULT_VARIABLE rc OUTPUT_VARIABLE file_list ERROR_VARIABLE git_error)
  if(NOT rc STREQUAL "0")
    scan_fail("firmware_scan: cannot list tracked files")
  endif()
  string(REPLACE "\n" ";" files "${file_list}")
  foreach(rel IN LISTS files)
    if(NOT rel STREQUAL "" AND EXISTS "${ROOT}/${rel}" AND NOT IS_DIRECTORY "${ROOT}/${rel}")
      scan_file("${ROOT}/${rel}" "${rel}")
      math(EXPR tracked_count "${tracked_count} + 1")
    endif()
  endforeach()
  if(tracked_count EQUAL 0)
    scan_fail("firmware_scan: tracked-file list is empty")
  endif()
endif()

if(DEFINED ZIPS AND NOT "${ZIPS}" STREQUAL "")
  set(zips "")
  foreach(item IN LISTS ZIPS)
    if(item MATCHES "[*?]")
      file(GLOB matched LIST_DIRECTORIES false "${item}")
      list(APPEND zips ${matched})
    else()
      list(APPEND zips "${item}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES zips)
  list(SORT zips)
  if(zips STREQUAL "")
    scan_fail("firmware_scan: no archives matched -DZIPS")
  endif()
  set(zip_index 0)
  foreach(zip IN LISTS zips)
    if(NOT EXISTS "${zip}" OR IS_DIRECTORY "${zip}")
      scan_fail("firmware_scan: an archive input is missing or is a directory")
    endif()
    get_filename_component(zip_abs "${zip}" ABSOLUTE)
    get_filename_component(zip_dir "${zip_abs}" DIRECTORY)
    file(REAL_PATH "${zip_dir}" zip_dir_real)
    set(zip_dir "${zip_dir_real}")
    cmake_path(IS_PREFIX zip_dir "${work}" NORMALIZE temp_in_archive_dir)
    if(temp_in_archive_dir)
      scan_fail("firmware_scan: extraction temporary directory is inside an input archive directory")
    endif()
    math(EXPR zip_index "${zip_index} + 1")
    set(out "${work}/${zip_index}")
    file(MAKE_DIRECTORY "${out}")
    execute_process(
      COMMAND "${CMAKE_COMMAND}" -E tar xf "${zip_abs}"
      WORKING_DIRECTORY "${out}" RESULT_VARIABLE rc
      OUTPUT_VARIABLE archive_out ERROR_VARIABLE archive_error)
    if(NOT rc STREQUAL "0")
      scan_fail("firmware_scan: archive cannot be extracted")
    endif()
    file(GLOB_RECURSE members LIST_DIRECTORIES false RELATIVE "${out}" "${out}/*")
    list(SORT members)
    if(members STREQUAL "")
      scan_fail("firmware_scan: archive yields no file members")
    endif()
    get_filename_component(name "${zip_abs}" NAME)
    foreach(member IN LISTS members)
      scan_file("${out}/${member}" "${name}/${member}")
      math(EXPR archive_count "${archive_count} + 1")
    endforeach()
    file(REMOVE_RECURSE "${out}")
  endforeach()
endif()

file(REMOVE_RECURSE "${work}")
if(NOT found STREQUAL "")
  list(LENGTH found match_count)
  list(JOIN found "\n  " match_text)
  message(FATAL_ERROR "firmware_scan: ${match_count} listed BIOS digest matches found\n  ${match_text}")
endif()
message(STATUS "firmware_scan: ${tracked_count} tracked files and ${archive_count} archive members; no listed BIOS digests")
