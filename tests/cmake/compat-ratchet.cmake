# Judge candidate and measured fixture rows, optionally against a protected prior ledger.
cmake_minimum_required(VERSION 3.25)
set(header "serial,md5,track1_sha1,title,region,media,predicate,status,evidence,date")
set(behavior_revision 4)

function(compat_fail text)
  message(FATAL_ERROR "compatibility: ${text}")
endfunction()

function(compat_days out date)
  if(NOT "${date}" MATCHES "^([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
    compat_fail("invalid date '${date}'")
  endif()
  set(y "${CMAKE_MATCH_1}")
  math(EXPR m "1${CMAKE_MATCH_2}-100")
  math(EXPR d "1${CMAKE_MATCH_3}-100")
  if(m LESS 1 OR m GREATER 12 OR d LESS 1)
    compat_fail("date out of range '${date}'")
  endif()
  set(month_days 31)
  if(m EQUAL 4 OR m EQUAL 6 OR m EQUAL 9 OR m EQUAL 11)
    set(month_days 30)
  elseif(m EQUAL 2)
    math(EXPR leap "${y}%4")
    math(EXPR century "${y}%100")
    math(EXPR quadcentury "${y}%400")
    if(leap EQUAL 0 AND (NOT century EQUAL 0 OR quadcentury EQUAL 0))
      set(month_days 29)
    else()
      set(month_days 28)
    endif()
  endif()
  if(d GREATER month_days)
    compat_fail("date out of range '${date}'")
  endif()
  if(m LESS_EQUAL 2)
    math(EXPR y "${y}-1")
    math(EXPR m "${m}+9")
  else()
    math(EXPR m "${m}-3")
  endif()
  math(EXPR era "${y}/400")
  math(EXPR yoe "${y}-${era}*400")
  math(EXPR doy "(153*${m}+2)/5+${d}-1")
  math(EXPR days "${era}*146097+${yoe}*365+${yoe}/4-${yoe}/100+${doy}-719468")
  set(${out} "${days}" PARENT_SCOPE)
endfunction()

function(load_ledger path prefix)
  set(semi_token "__COMPAT_SEMICOLON_ESCAPE__")
  if(NOT EXISTS "${path}")
    compat_fail("missing ledger '${path}'")
  endif()
  file(READ "${path}" contents)
  if(contents MATCHES "${semi_token}")
    compat_fail("reserved escape token in '${path}'")
  endif()
  string(REPLACE ";" "${semi_token}" contents "${contents}")
  string(REPLACE "\r" "" contents "${contents}")
  string(REPLACE "\n" ";" contents "${contents}")
  set(rows ${contents})
  list(POP_FRONT rows first)
  if(NOT first STREQUAL header)
    compat_fail("wrong ten-column header in '${path}'")
  endif()
  set(keys "")
  foreach(row IN LISTS rows)
    if(row MATCHES "[\"\r]")
      compat_fail("quoted or carriage-return field in '${path}'")
    endif()
    string(REPLACE "," ";" escaped "${row}")
    set(fields ${escaped})
    list(LENGTH fields count)
    if(NOT count EQUAL 10)
      compat_fail("row does not have ten fields in '${path}'")
    endif()
    foreach(i RANGE 0 9)
      list(GET fields ${i} value)
      string(REPLACE "${semi_token}" ";" value "${value}")
      if(value STREQUAL "")
        compat_fail("empty field in '${path}'")
      endif()
      set(f${i} "${value}")
    endforeach()
    if(NOT f7 MATCHES "^(unknown|fail|pass)$")
      compat_fail("invalid status '${f7}'")
    endif()
    compat_days(unused "${f9}")
    set(key "${f0}|${f1}|${f6}")
    list(FIND keys "${key}" duplicate)
    if(NOT duplicate EQUAL -1)
      compat_fail("duplicate serial+md5+predicate key '${key}'")
    endif()
    list(APPEND keys "${key}")
    string(SHA256 hash "${key}")
    set(${prefix}_${hash}_status "${f7}" PARENT_SCOPE)
    set(${prefix}_${hash}_row "${row}" PARENT_SCOPE)
    set(${prefix}_${hash}_key "${key}" PARENT_SCOPE)
  endforeach()
  set(${prefix}_keys "${keys}" PARENT_SCOPE)
endfunction()

function(has_allowance out key allow_file today)
  set(found FALSE)
  compat_days(today_days "${today}")
  file(STRINGS "${allow_file}" lines)
  foreach(line IN LISTS lines)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(NOT line MATCHES "^([0-9-]+) ([^ ]+) ([^ ]+) ([^ ]+) behavior-rev=([1-9][0-9]*) expires=([0-9-]+) .+")
      compat_fail("malformed allowance '${line}'")
    endif()
    set(start "${CMAKE_MATCH_1}")
    set(serial "${CMAKE_MATCH_2}")
    set(md5 "${CMAKE_MATCH_3}")
    set(predicate "${CMAKE_MATCH_4}")
    set(revision "${CMAKE_MATCH_5}")
    set(expiry "${CMAKE_MATCH_6}")
    if(NOT revision EQUAL behavior_revision)
      compat_fail("allowance does not name behavior revision ${behavior_revision}")
    endif()
    compat_days(start_days "${start}")
    compat_days(expiry_days "${expiry}")
    math(EXPR span "${expiry_days}-${start_days}")
    if(span LESS 0 OR span GREATER 60)
      compat_fail("allowance window exceeds 60 days")
    endif()
    if("${serial}|${md5}|${predicate}" STREQUAL "${key}" AND
       today_days GREATER_EQUAL start_days AND today_days LESS_EQUAL expiry_days)
      set(found TRUE)
    endif()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

foreach(required LEDGER FRESH ALLOW TODAY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    compat_fail("-D${required} is required")
  endif()
endforeach()
load_ledger("${LEDGER}" candidate)
load_ledger("${FRESH}" fresh)
compat_days(today_days "${TODAY}")
foreach(key IN LISTS candidate_keys)
  string(SHA256 hash "${key}")
  list(FIND fresh_keys "${key}" fresh_index)
  if(fresh_index EQUAL -1)
    compat_fail("ledger result has no fresh fixture result for '${key}'")
  endif()
  if(NOT candidate_${hash}_status STREQUAL fresh_${hash}_status)
    compat_fail("fresh result disagrees for '${key}'")
  endif()
endforeach()
foreach(key IN LISTS fresh_keys)
  string(SHA256 hash "${key}")
  list(FIND candidate_keys "${key}" candidate_index)
  if(candidate_index EQUAL -1 OR NOT candidate_${hash}_status STREQUAL fresh_${hash}_status)
    compat_fail("fresh result is absent from or disagrees with ledger for '${key}'")
  endif()
endforeach()
if(DEFINED BASE AND NOT "${BASE}" STREQUAL "")
  load_ledger("${BASE}" prior)
  foreach(key IN LISTS prior_keys)
    string(SHA256 hash "${key}")
    list(FIND candidate_keys "${key}" next_index)
    if(NOT next_index EQUAL -1)
      set(before "${prior_${hash}_status}")
      set(after "${candidate_${hash}_status}")
      if((before STREQUAL "unknown") OR (before STREQUAL "fail" AND after STREQUAL "pass") OR
         (before STREQUAL "pass" AND after STREQUAL "pass"))
        continue()
      endif()
    endif()
    has_allowance(allowed "${key}" "${ALLOW}" "${TODAY}")
    if(NOT allowed)
      compat_fail("prior result changed or disappeared without a dated allowance: '${key}'")
    endif()
  endforeach()
endif()
message(STATUS "compatibility: accepted ten-column ledger and fresh results")
