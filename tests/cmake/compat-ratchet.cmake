# Judge candidate and measured fixture rows, optionally against a protected prior ledger.
cmake_minimum_required(VERSION 3.25)
set(title_schema "serial,md5,track1_sha1,title,region,media,predicate,status,evidence,date" 10 6 7 8 9 |)
set(features_schema "provider,profile,protection,peripheral,predicate,status,evidence,date" 8 4 5 6 7 !)
set(behavior_revision 4)

function(compat_fail text)
  message(FATAL_ERROR "compatibility: ${text}")
endfunction()
function(compat_days out date)
  if(NOT "${date}" MATCHES "^([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
    compat_fail("invalid date '${date}'")
  endif()
  math(EXPR y "1${CMAKE_MATCH_1}-10000")
  math(EXPR m "1${CMAKE_MATCH_2}-100")
  math(EXPR d "1${CMAKE_MATCH_3}-100")
  if(m LESS 1 OR m GREATER 12 OR d LESS 1)
    compat_fail("date out of range '${date}'")
  endif()
  set(month_days 31 28 31 30 31 30 31 31 30 31 30 31)
  math(EXPR month_index "${m}-1")
  list(GET month_days ${month_index} month_limit)
  if(m EQUAL 2)
    math(EXPR leap "(${y}+4000)/4-(${y}+3999)/4-(${y}+4000)/100+(${y}+3999)/100+(${y}+4000)/400-(${y}+3999)/400")
    if(leap)
      set(month_limit 29)
    endif()
  endif()
  if(d GREATER month_limit)
    compat_fail("date out of range '${date}'")
  endif()
  math(EXPR a "(14-${m})/12")
  math(EXPR days "${d}+(153*(${m}+12*${a}-3)+2)/5+365*(${y}+4800-${a})+(${y}+4800-${a})/4-(${y}+4800-${a})/100+(${y}+4800-${a})/400")
  set(${out} "${days}" PARENT_SCOPE)
endfunction()
function(load_ledger path prefix kind max_rows)
  set(schema "${${kind}_schema}")
  list(POP_FRONT schema expected_header column_count key2 status_index evidence_index date_index key_separator)
  set(semi_token "__COMPAT_SEMICOLON_ESCAPE__")
  if(NOT EXISTS "${path}")
    compat_fail("missing ledger '${path}'")
  endif()
  file(READ "${path}" contents)
  if(contents MATCHES "${semi_token}")
    compat_fail("reserved escape token in '${path}'")
  endif()
  string(REPLACE ";" "${semi_token}" contents "${contents}")
  string(REPLACE "\r" "" contents "${contents}")
  string(REPLACE "\n" ";" contents "${contents}")
  set(rows ${contents})
  list(POP_FRONT rows first)
  if(NOT first STREQUAL expected_header)
    compat_fail("wrong ${column_count}-column header in '${path}'")
  endif()
  set(keys "")
  foreach(row IN LISTS rows)
    if(row MATCHES "[\"\r]")
      compat_fail("quoted or carriage-return field in '${path}'")
    endif()
    string(REPLACE "," ";" escaped "${row}")
    set(fields ${escaped})
    list(LENGTH fields count)
    if(NOT count EQUAL column_count)
      compat_fail("row does not have ${column_count} fields in '${path}'")
    endif()
    math(EXPR last_index "${column_count}-1")
    foreach(i RANGE 0 ${last_index})
      list(GET fields ${i} value)
      string(REPLACE "${semi_token}" ";" value "${value}")
      if(value STREQUAL "")
        compat_fail("empty field in '${path}'")
      endif()
      set(f${i} "${value}")
      if(kind STREQUAL "features" AND i LESS 5 AND NOT "${value}" MATCHES "^[A-Za-z0-9][A-Za-z0-9._+-]*$")
        compat_fail("invalid feature key field '${value}'")
      endif()
      if(kind STREQUAL "features" AND i EQUAL 4)
        set(f4 "${f2}${key_separator}${f3}${key_separator}${f4}")
      endif()
    endforeach()
    set(key "${f0}${key_separator}${f1}${key_separator}${f${key2}}")
    set(status "${f${status_index}}")
    if(NOT status MATCHES "^(unknown|fail|pass)$")
      compat_fail("invalid status '${status}'")
    endif()
    compat_days(unused "${f${date_index}}")
    list(FIND keys "${key}" duplicate)
    if(NOT duplicate EQUAL -1)
      compat_fail("duplicate ledger key '${key}'")
    endif()
    list(APPEND keys "${key}")
    string(SHA256 hash "${key}")
    set(${prefix}_${hash}_status "${status}" PARENT_SCOPE)
    set(${prefix}_${hash}_evidence "${f${evidence_index}}" PARENT_SCOPE)
  endforeach()
  if(kind STREQUAL "features")
    list(LENGTH keys row_count)
    if(row_count LESS 1 OR row_count GREATER max_rows)
      compat_fail("feature row count is outside 1..${max_rows} in '${path}'")
    endif()
    set(sorted_keys "${keys}")
    list(SORT sorted_keys)
    if(NOT "${keys}" STREQUAL "${sorted_keys}")
      compat_fail("feature rows are not sorted by provider, profile, protection, peripheral and predicate in '${path}'")
    endif()
  endif()
  set(${prefix}_keys "${keys}" PARENT_SCOPE)
endfunction()
function(has_allowance out key allow_file today_days)
  set(found FALSE)
  file(STRINGS "${allow_file}" lines)
  foreach(line IN LISTS lines)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(NOT line MATCHES "^([0-9-]+) ([^ ]+) ([^ ]+) ([^ ]+) behavior-rev=([1-9][0-9]*) expires=([0-9-]+) .+")
      compat_fail("malformed allowance '${line}'")
    endif()
    set(start "${CMAKE_MATCH_1}")
    set(allowance_key "${CMAKE_MATCH_2}${key_separator}${CMAKE_MATCH_3}${key_separator}${CMAKE_MATCH_4}")
    set(revision "${CMAKE_MATCH_5}")
    set(expiry "${CMAKE_MATCH_6}")
    if(NOT revision EQUAL behavior_revision)
      compat_fail("allowance does not name behavior revision ${behavior_revision}")
    endif()
    compat_days(start_days "${start}")
    compat_days(expiry_days "${expiry}")
    math(EXPR span "${expiry_days}-${start_days}")
    if(span LESS 0 OR span GREATER 60)
      compat_fail("allowance window exceeds 60 days")
    endif()
    if("${allowance_key}" STREQUAL "${key}" AND
       today_days GREATER_EQUAL start_days AND today_days LESS_EQUAL expiry_days)
      set(found TRUE)
    endif()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

set(feature_max_rows 2147483647)
if(DEFINED FEATURE_MAX_ROWS)
  string(LENGTH "${FEATURE_MAX_ROWS}" limit_length)
  if(NOT "${FEATURE_MAX_ROWS}" MATCHES "^[1-9][0-9]*$" OR limit_length GREATER 10 OR
     FEATURE_MAX_ROWS GREATER feature_max_rows)
    compat_fail("FEATURE_MAX_ROWS must be between 1 and ${feature_max_rows}")
  endif()
  set(feature_max_rows "${FEATURE_MAX_ROWS}")
endif()
if(DEFINED MODE AND MODE STREQUAL "features-preflight")
  if(NOT DEFINED FEATURES OR "${FEATURES}" STREQUAL "")
    compat_fail("-DFEATURES is required for feature preflight")
  endif()
  load_ledger("${FEATURES}" preflight features "${feature_max_rows}")
  message(STATUS "compatibility: accepted feature schema, keys, order and bounded row count")
  return()
endif()
if(NOT DEFINED KIND OR "${KIND}" STREQUAL "")
  set(KIND title)
endif()
if(NOT KIND MATCHES "^(title|features)$")
  compat_fail("unknown ledger kind '${KIND}'")
endif()
set(key_separator "|")
if(KIND STREQUAL "features")
  set(key_separator "!")
endif()
foreach(required LEDGER FRESH ALLOW TODAY)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    compat_fail("-D${required} is required")
  endif()
endforeach()
load_ledger("${LEDGER}" candidate "${KIND}" "${feature_max_rows}")
load_ledger("${FRESH}" fresh "${KIND}" "${feature_max_rows}")
compat_days(today_days "${TODAY}")
list(LENGTH candidate_keys candidate_count)
list(LENGTH fresh_keys fresh_count)
if(NOT candidate_count EQUAL fresh_count)
  compat_fail("fresh fixture keys differ from the candidate ledger")
endif()
foreach(key IN LISTS candidate_keys)
  string(SHA256 hash "${key}")
  if(NOT DEFINED fresh_${hash}_status)
    compat_fail("ledger result has no fresh fixture result for '${key}'")
  endif()
  if(NOT candidate_${hash}_status STREQUAL fresh_${hash}_status OR (KIND STREQUAL "features" AND NOT candidate_${hash}_evidence STREQUAL fresh_${hash}_evidence))
    compat_fail("fresh result or evidence disagrees for '${key}'")
  endif()
endforeach()
if(DEFINED BASE AND NOT "${BASE}" STREQUAL "")
  load_ledger("${BASE}" prior "${KIND}" "${feature_max_rows}")
  foreach(key IN LISTS prior_keys)
    string(SHA256 hash "${key}")
    if(DEFINED candidate_${hash}_status AND
       (prior_${hash}_status STREQUAL "unknown" OR candidate_${hash}_status STREQUAL "pass"))
      continue()
    endif()
    has_allowance(allowed "${key}" "${ALLOW}" "${today_days}")
    if(NOT allowed)
      compat_fail("prior result changed or disappeared without a dated allowance: '${key}'")
    endif()
  endforeach()
endif()
message(STATUS "compatibility: accepted ${KIND} ledger and fresh results")
