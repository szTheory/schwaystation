# cmake -DROOT=<dir> -DMANIFEST=<manifest.txt> -DNOTICES=<notices.md> -P notices.cmake
# Fault prevented: a committed third-party binary or table whose notice does not name it, or a
# notice naming a path that does not exist. Seeded from szTheory/cogmaster f09ac97096ac (MIT).
cmake_minimum_required(VERSION 3.25)
if(NOT IS_DIRECTORY "${ROOT}" OR NOT EXISTS "${MANIFEST}" OR NOT EXISTS "${NOTICES}")
  message(FATAL_ERROR "notices: -DROOT, -DMANIFEST and -DNOTICES must name existing paths")
endif()
file(READ "${NOTICES}" notices)
string(REGEX MATCHALL "[^\n]*Applies to[^\n]*" applies "${notices}")
string(REGEX MATCHALL "`[^`]+`" named "${applies}")
list(TRANSFORM named REPLACE "`" "")
set(errors "")
foreach(path IN LISTS named)
  if(NOT EXISTS "${ROOT}/${path}")
    string(APPEND errors "\n  the notices name ${path}, which does not exist")
  endif()
endforeach()
file(STRINGS "${MANIFEST}" rows REGEX "^[^#]")
foreach(row IN LISTS rows)
  string(REPLACE "\t" ";" fields "${row}")
  list(GET fields 0 path)
  list(GET fields 5 notice)
  if(NOT notice STREQUAL "-" AND NOT path IN_LIST named)
    string(APPEND errors "\n  ${path} has a notice in the manifest but is on no Applies-to line")
  endif()
endforeach()
if(errors)
  message(FATAL_ERROR "notices:${errors}")
endif()
message(STATUS "notices: every noticed manifest row is named, every named path exists")
