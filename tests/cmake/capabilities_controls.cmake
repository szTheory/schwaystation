# Fault prevented: stale, incomplete, malformed, or mismatched compatibility evidence clearing required claims.
cmake_minimum_required(VERSION 3.25)

if(CMAKE_SCRIPT_MODE_FILE AND CASE STREQUAL "compat_capabilities_coverage")
  set(matrix "${SOURCE_ROOT}/tests/compat/required-capabilities.csv")
  set(module "${SOURCE_ROOT}/tests/cmake/Capabilities.cmake")
  if(NOT EXISTS "${matrix}")
    message(FATAL_ERROR "capability coverage assertion: committed required matrix is missing")
  endif()
  include("${module}")
  schway_capabilities_validate_matrix("${matrix}" row_count)
  if(NOT row_count EQUAL 51)
    message(FATAL_ERROR "capability coverage assertion: expected all 51 legal required rows, found ${row_count}")
  endif()
  file(READ "${matrix}" base_matrix)
  function(capabilities_reject_matrix name candidate)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCAPABILITIES_VALIDATE_MATRIX=${candidate}"
      -P "${module}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(rc STREQUAL "0")
      message(FATAL_ERROR "capability coverage assertion: ${name} matrix was accepted: ${out}${err}")
    endif()
  endfunction()
  set(wrong_predicate "${WORK_ROOT}/capabilities-wrong-predicate.csv")
  string(REPLACE "provider.iso,provider,iso,boot_input_picture_audio,compat.play.provider.iso,always"
    "provider.iso,provider,iso,boot_only,compat.play.provider.iso,always" mutated "${base_matrix}")
  if(mutated STREQUAL base_matrix)
    message(FATAL_ERROR "capability coverage assertion: ISO row was absent from the test fixture")
  endif()
  file(WRITE "${wrong_predicate}" "${mutated}")
  capabilities_reject_matrix("altered predicate" "${wrong_predicate}")
  set(wrong_selector "${WORK_ROOT}/capabilities-wrong-selector.csv")
  string(REPLACE "provider.iso,provider,iso,boot_input_picture_audio,compat.play.provider.iso,always"
    "provider.iso,provider,iso,boot_input_picture_audio,runner.profile.select,always" mutated "${base_matrix}")
  file(WRITE "${wrong_selector}" "${mutated}")
  capabilities_reject_matrix("altered producer selector" "${wrong_selector}")
  set(wrong_profile_gpu "${WORK_ROOT}/capabilities-wrong-profile-gpu.csv")
  string(REPLACE "profile.ntsc-j.pu7.gpu1,profile,ntsc-j/pu7/gpu1,boot_input_picture_audio,compat.play.profile.ntsc-j.pu7.gpu1,always"
    "profile.ntsc-j.pu7.gpu0,profile,ntsc-j/pu7/gpu0,boot_input_picture_audio,compat.play.profile.ntsc-j.pu7.gpu0,always" mutated "${base_matrix}")
  file(WRITE "${wrong_profile_gpu}" "${mutated}")
  capabilities_reject_matrix("illegal board/GPU tuple" "${wrong_profile_gpu}")
  set(missing_row "${WORK_ROOT}/capabilities-missing-row.csv")
  string(REPLACE "provider.iso,provider,iso,boot_input_picture_audio,compat.play.provider.iso,always\n"
    "" mutated "${base_matrix}")
  file(WRITE "${missing_row}" "${mutated}")
  capabilities_reject_matrix("removed required row" "${missing_row}")
  set(duplicate_row "${WORK_ROOT}/capabilities-duplicate-row.csv")
  file(WRITE "${duplicate_row}" "${base_matrix}provider.iso,provider,iso,boot_input_picture_audio,compat.play.provider.iso,always\n")
  capabilities_reject_matrix("duplicate required row" "${duplicate_row}")
  return()
endif()

if(CMAKE_SCRIPT_MODE_FILE AND CASE STREQUAL "compat_capabilities_results")
  set(matrix "${SOURCE_ROOT}/tests/compat/required-capabilities.csv")
  set(module "${SOURCE_ROOT}/tests/cmake/Capabilities.cmake")
  if(NOT EXISTS "${matrix}" OR NOT EXISTS "${module}")
    message(FATAL_ERROR "capability results assertion: matrix and evaluator must exist")
  endif()
  include("${module}")
  set(root "${WORK_ROOT}/compat-capabilities-results")
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}")
  set(source_probe "${root}/source-probe")
  file(MAKE_DIRECTORY "${source_probe}/src")
  file(WRITE "${source_probe}/src/instance.c" "static int value = 1;\n")
  schway_capabilities_source_material("${source_probe}" probe_material probe_before probe_files)
  file(APPEND "${source_probe}/src/instance.c" "static int changed = 2;\n")
  schway_capabilities_source_material("${source_probe}" probe_material probe_after probe_files)
  if(probe_before STREQUAL probe_after)
    message(FATAL_ERROR "capability results assertion: a core source edit did not change the source digest")
  endif()
  file(STRINGS "${matrix}" rows)
  set(selectors)
  foreach(row IN LISTS rows)
    if(row STREQUAL "" OR row MATCHES "^id,")
      continue()
    endif()
    string(REPLACE "," ";" fields "${row}")
    list(GET fields 4 selector)
    list(APPEND selectors "${selector}")
  endforeach()
  list(REMOVE_DUPLICATES selectors)
  list(LENGTH selectors selector_count)
  set(junit "${root}/all-pass.xml")
  file(WRITE "${junit}" "<testsuite tests=\"${selector_count}\" failures=\"0\">\n")
  foreach(selector IN LISTS selectors)
    file(APPEND "${junit}" "<testcase name=\"${selector}\" classname=\"synthetic\"/>\n")
  endforeach()
  file(APPEND "${junit}" "</testsuite>\n")
  set(fingerprint "synthetic-source-fingerprint")
  set(configuration "synthetic|chd=off")
  set(configured_at "2000-01-01T00:00:00Z")
  set(results "${root}/results.csv")
  schway_capabilities_import_junit("${matrix}" "${junit}" "${fingerprint}"
    "${configuration}" "${configured_at}" "${results}")
  schway_capabilities_evaluate("${matrix}" "${results}" "${fingerprint}"
    "${configuration}" all_pass)
  if(NOT all_pass)
    message(FATAL_ERROR "capability result assertion: a complete current all-pass report must be eligible")
  endif()
  set(no_chd_junit "${root}/no-chd.xml")
  file(READ "${junit}" all_pass_report)
  string(REPLACE "<testcase name=\"compat.play.provider.chd\" classname=\"synthetic\"/>\n" "" no_chd_report "${all_pass_report}")
  math(EXPR no_chd_count "${selector_count} - 1")
  string(REPLACE "tests=\"${selector_count}\"" "tests=\"${no_chd_count}\"" no_chd_report "${no_chd_report}")
  file(WRITE "${no_chd_junit}" "${no_chd_report}")
  set(chd_results "${root}/chd-results.csv")
  schway_capabilities_import_junit("${matrix}" "${no_chd_junit}" "${fingerprint}"
    "synthetic|chd=off" "${configured_at}" "${chd_results}")
  schway_capabilities_evaluate("${matrix}" "${chd_results}" "${fingerprint}"
    "synthetic|chd=off" chd_off_eligible)
  if(NOT chd_off_eligible)
    message(FATAL_ERROR "capability result assertion: a CHD-off build must not require the optional CHD producer")
  endif()
  schway_capabilities_import_junit("${matrix}" "${no_chd_junit}" "${fingerprint}"
    "synthetic|chd=on" "${configured_at}" "${chd_results}")
  schway_capabilities_evaluate("${matrix}" "${chd_results}" "${fingerprint}"
    "synthetic|chd=on" chd_on_eligible)
  if(chd_on_eligible)
    message(FATAL_ERROR "capability result assertion: a CHD-on build must require its provider result")
  endif()
  file(SHA256 "${matrix}" matrix_before)
  file(SHA256 "${junit}" junit_before)
  file(SHA256 "${results}" results_before)
  function(capabilities_require_ineligible name candidate expected_fingerprint expected_configuration)
    schway_capabilities_evaluate("${matrix}" "${candidate}" "${expected_fingerprint}"
      "${expected_configuration}" eligible)
    if(eligible)
      message(FATAL_ERROR "capability result assertion: ${name} unexpectedly passed")
    endif()
  endfunction()
  capabilities_require_ineligible("stale source fingerprint" "${results}" "stale-fingerprint" "${configuration}")
  capabilities_require_ineligible("stale build configuration" "${results}" "${fingerprint}" "stale-configuration")
  set(variant "${root}/variant.csv")
  file(READ "${results}" base_results)
  set(good_row "provider.iso,${fingerprint},${configuration},compat.play.provider.iso,boot_input_picture_audio,pass,junit:compat.play.provider.iso")
  string(REPLACE "${good_row}" "provider.iso,wrong-fingerprint,${configuration},compat.play.provider.iso,boot_input_picture_audio,pass,junit:compat.play.provider.iso" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("tampered source fingerprint" "${variant}" "${fingerprint}" "${configuration}")
  string(REPLACE "${good_row}" "provider.iso,${fingerprint},${configuration},not-the-producer,boot_input_picture_audio,pass,junit:compat.play.provider.iso" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("wrong producer" "${variant}" "${fingerprint}" "${configuration}")
  string(REPLACE "${good_row}" "provider.iso,${fingerprint},${configuration},compat.play.provider.iso,profile_select,pass,junit:compat.play.provider.iso" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("wrong predicate" "${variant}" "${fingerprint}" "${configuration}")
  string(REPLACE "${good_row}" "provider.iso,${fingerprint},${configuration},compat.play.provider.iso,boot_input_picture_audio,fail,junit:failed" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("failed result" "${variant}" "${fingerprint}" "${configuration}")
  string(REPLACE "${good_row}" "provider.iso,${fingerprint},${configuration},compat.play.provider.iso,boot_input_picture_audio,unknown,junit:unknown" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("unknown result" "${variant}" "${fingerprint}" "${configuration}")
  string(REPLACE "${good_row}\n" "" changed "${base_results}")
  file(WRITE "${variant}" "${changed}")
  capabilities_require_ineligible("omitted required result" "${variant}" "${fingerprint}" "${configuration}")
  file(WRITE "${variant}" "${base_results}${good_row}\n")
  capabilities_require_ineligible("duplicate required result" "${variant}" "${fingerprint}" "${configuration}")
  file(READ "${junit}" base_junit)
  string(REPLACE "<testcase name=\"compat.play.provider.iso\" classname=\"synthetic\"/>\n" "" omitted "${base_junit}")
  string(REPLACE "</testsuite>" "" truncated "${base_junit}")
  foreach(control IN ITEMS omitted truncated)
    file(WRITE "${root}/${control}.xml" "${${control}}")
    schway_capabilities_import_junit("${matrix}" "${root}/${control}.xml" "${fingerprint}"
      "${configuration}" "${configured_at}" "${variant}")
    capabilities_require_ineligible("${control} JUnit" "${variant}" "${fingerprint}" "${configuration}")
  endforeach()
  set(failed_junit "${root}/failed.xml")
  file(WRITE "${failed_junit}" "<testsuite tests=\"1\" failures=\"1\"><testcase name=\"compat.play.provider.iso\"><failure message=\"failed\"/></testcase></testsuite>\n")
  schway_capabilities_import_junit("${matrix}" "${failed_junit}" "${fingerprint}"
    "${configuration}" "${configured_at}" "${variant}")
  capabilities_require_ineligible("failed producer test" "${variant}" "${fingerprint}" "${configuration}")
  schway_capabilities_import_junit("${matrix}" "${junit}" "${fingerprint}"
    "${configuration}" "2999-01-01T00:00:00Z" "${variant}")
  capabilities_require_ineligible("stale JUnit report" "${variant}" "${fingerprint}" "${configuration}")
  file(SHA256 "${matrix}" matrix_after)
  file(SHA256 "${junit}" junit_after)
  file(SHA256 "${results}" results_after)
  if(NOT matrix_before STREQUAL matrix_after OR NOT junit_before STREQUAL junit_after OR
     NOT results_before STREQUAL results_after)
    message(FATAL_ERROR "capability result assertion: evaluator modified an input or baseline result record")
  endif()
  return()
endif()

if(CMAKE_SCRIPT_MODE_FILE AND CASE STREQUAL "compat_capabilities_claims")
  foreach(required SOURCE_ROOT WORK_ROOT INFO_FILE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "capability claims assertion: ${required} is required")
    endif()
  endforeach()
  if(NOT EXISTS "${INFO_FILE}")
    message(FATAL_ERROR "capability claims assertion: generated .info file is missing")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=capabilities "-DROOT=${SOURCE_ROOT}"
      -P "${SOURCE_ROOT}/tests/cmake/workflows.cmake"
    RESULT_VARIABLE workflow_rc OUTPUT_VARIABLE workflow_out ERROR_VARIABLE workflow_err)
  if(NOT workflow_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: package workflow does not import completed evidence before copying .info: ${workflow_out}${workflow_err}")
  endif()
  include("${SOURCE_ROOT}/tests/cmake/Capabilities.cmake")
  set(expected_experimental true)
  set(config_file "${WORK_ROOT}/compat/capabilities-config.csv")
  set(matrix "${SOURCE_ROOT}/tests/compat/required-capabilities.csv")
  set(results "${WORK_ROOT}/compat/capabilities-results.csv")
  if(EXISTS "${config_file}")
    file(STRINGS "${config_file}" config_rows)
    list(POP_FRONT config_rows)
    string(REPLACE "," ";" config_values "${config_rows}")
    list(LENGTH config_values config_count)
    if(NOT config_count EQUAL 4)
      message(FATAL_ERROR "capability claims assertion: configure fingerprint is malformed")
    endif()
    list(GET config_values 0 fingerprint)
    list(GET config_values 1 configuration)
    schway_capabilities_evaluate("${matrix}" "${results}" "${fingerprint}"
      "${configuration}" eligible)
    if(eligible)
      set(expected_experimental false)
    endif()
  endif()
  file(STRINGS "${INFO_FILE}" info_lines)
  set(experimental_value "")
  set(cheats_value "")
  foreach(line IN LISTS info_lines)
    if(line MATCHES "^is_experimental = \"([^\"]+)\"$")
      set(experimental_value "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^cheats = \"([^\"]+)\"$")
      set(cheats_value "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT experimental_value STREQUAL expected_experimental)
    message(FATAL_ERROR "capability claims assertion: is_experimental=${experimental_value}, expected ${expected_experimental} from current results")
  endif()
  if(NOT cheats_value STREQUAL "true")
    message(FATAL_ERROR "capability claims assertion: cheats must be true only with the registered apply, controls, and state guards")
  endif()
  file(STRINGS "${SOURCE_ROOT}/tests/libretro/inventory.txt" host_inventory)
  foreach(guard IN ITEMS libretro.cheats.apply libretro.cheats.controls libretro.cheats.state)
    set(found FALSE)
    foreach(row IN LISTS host_inventory)
      if(row MATCHES "^${guard}[ \t]")
        set(found TRUE)
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "capability claims assertion: missing host guard ${guard}")
    endif()
  endforeach()
  set(synthetic_root "${WORK_ROOT}/compat-capabilities-claims")
  file(REMOVE_RECURSE "${synthetic_root}")
  file(MAKE_DIRECTORY "${synthetic_root}")
  file(STRINGS "${matrix}" matrix_rows)
  set(selectors)
  foreach(row IN LISTS matrix_rows)
    if(row STREQUAL "" OR row MATCHES "^id,")
      continue()
    endif()
    string(REPLACE "," ";" fields "${row}")
    list(GET fields 4 selector)
    list(APPEND selectors "${selector}")
  endforeach()
  list(REMOVE_DUPLICATES selectors)
  list(LENGTH selectors selector_count)
  set(synthetic_junit "${synthetic_root}/all-pass.xml")
  file(WRITE "${synthetic_junit}" "<testsuite tests=\"${selector_count}\" failures=\"0\">\n")
  foreach(selector IN LISTS selectors)
    file(APPEND "${synthetic_junit}" "<testcase name=\"${selector}\" classname=\"synthetic\"/>\n")
  endforeach()
  file(APPEND "${synthetic_junit}" "</testsuite>\n")
  set(synthetic_fingerprint "synthetic-source-fingerprint")
  set(synthetic_configuration "synthetic|chd=off")
  schway_capabilities_source_material("${SOURCE_ROOT}" synthetic_material synthetic_source_digest synthetic_source_files)
  set(synthetic_config "${synthetic_root}/config.csv")
  file(WRITE "${synthetic_config}" "fingerprint,configuration,source_digest,configured_at\n${synthetic_fingerprint},${synthetic_configuration},${synthetic_source_digest},2000-01-01T00:00:00Z\n")
  set(synthetic_info "${synthetic_root}/all-pass.info")
  file(COPY_FILE "${INFO_FILE}" "${synthetic_info}")
  set(synthetic_results "${synthetic_root}/results.csv")
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DCAPABILITIES_MATRIX=${matrix}" "-DCAPABILITIES_JUNIT=${synthetic_junit}"
      "-DCAPABILITIES_CONFIG=${synthetic_config}" "-DCAPABILITIES_OUTPUT=${synthetic_results}"
      "-DCAPABILITIES_SOURCE_ROOT=${SOURCE_ROOT}" "-DCAPABILITIES_INFO=${synthetic_info}"
      -P "${SOURCE_ROOT}/tests/cmake/Capabilities.cmake"
    RESULT_VARIABLE synthetic_rc OUTPUT_VARIABLE synthetic_out ERROR_VARIABLE synthetic_err)
  if(NOT synthetic_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: production evaluator rejected synthetic all-pass controls: ${synthetic_out}${synthetic_err}")
  endif()
  file(STRINGS "${synthetic_info}" synthetic_info_lines)
  if(NOT "${synthetic_info_lines}" MATCHES "is_experimental = \"false\"")
    message(FATAL_ERROR "capability claims assertion: production evaluator did not make the synthetic all-pass metadata non-experimental")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DINFO_FILE=${synthetic_info}" "-DINVENTORY=${SOURCE_ROOT}/tests/libretro/inventory.txt"
      -DEXPECTED_EXPERIMENTAL=false -DEXPECTED_CHEATS=true
      -P "${SOURCE_ROOT}/tests/cmake/info_claims.cmake"
    RESULT_VARIABLE synthetic_claims_rc OUTPUT_VARIABLE synthetic_claims_out ERROR_VARIABLE synthetic_claims_err)
  if(NOT synthetic_claims_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: all-pass metadata failed the regular claims guard: ${synthetic_claims_out}${synthetic_claims_err}")
  endif()
  set(staged_info "${synthetic_root}/staged/info/schwaystation_libretro.info")
  get_filename_component(staged_info_dir "${staged_info}" DIRECTORY)
  file(MAKE_DIRECTORY "${staged_info_dir}")
  file(COPY_FILE "${synthetic_info}" "${staged_info}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DINFO_FILE=${staged_info}" "-DINVENTORY=${SOURCE_ROOT}/tests/libretro/inventory.txt"
      -DEXPECTED_EXPERIMENTAL=false -DEXPECTED_CHEATS=true
      -P "${SOURCE_ROOT}/tests/cmake/info_claims.cmake"
    RESULT_VARIABLE staged_claims_rc OUTPUT_VARIABLE staged_claims_out ERROR_VARIABLE staged_claims_err)
  if(NOT staged_claims_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: staged .info did not retain freshly imported eligibility: ${staged_claims_out}${staged_claims_err}")
  endif()
  set(stale_config "${synthetic_root}/stale-config.csv")
  file(WRITE "${stale_config}" "fingerprint,configuration,source_digest,configured_at\n${synthetic_fingerprint},${synthetic_configuration},stale-source-digest,2000-01-01T00:00:00Z\n")
  set(stale_info "${synthetic_root}/stale-source.info")
  file(COPY_FILE "${INFO_FILE}" "${stale_info}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DCAPABILITIES_MATRIX=${matrix}" "-DCAPABILITIES_JUNIT=${synthetic_junit}"
      "-DCAPABILITIES_CONFIG=${stale_config}" "-DCAPABILITIES_OUTPUT=${synthetic_root}/stale-results.csv"
      "-DCAPABILITIES_SOURCE_ROOT=${SOURCE_ROOT}" "-DCAPABILITIES_INFO=${stale_info}"
      -P "${SOURCE_ROOT}/tests/cmake/Capabilities.cmake"
    RESULT_VARIABLE stale_rc OUTPUT_VARIABLE stale_out ERROR_VARIABLE stale_err)
  if(NOT stale_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: stale source hash control errored: ${stale_out}${stale_err}")
  endif()
  file(STRINGS "${stale_info}" stale_info_lines)
  if(NOT "${stale_info_lines}" MATCHES "is_experimental = \"true\"")
    message(FATAL_ERROR "capability claims assertion: changed source digest cleared the experimental marker")
  endif()
  set(failed_info "${synthetic_root}/failed.info")
  file(COPY_FILE "${INFO_FILE}" "${failed_info}")
  file(READ "${synthetic_junit}" failed_report)
  string(REPLACE "failures=\"0\"" "failures=\"1\"" failed_report "${failed_report}")
  string(REPLACE "</testsuite>" "<testcase name=\"compat.play.provider.iso\"><failure message=\"failed\"/></testcase></testsuite>" failed_report "${failed_report}")
  set(failed_junit "${synthetic_root}/failed.xml")
  file(WRITE "${failed_junit}" "${failed_report}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DCAPABILITIES_MATRIX=${matrix}" "-DCAPABILITIES_JUNIT=${failed_junit}"
      "-DCAPABILITIES_CONFIG=${synthetic_config}" "-DCAPABILITIES_OUTPUT=${synthetic_root}/failed-results.csv"
      "-DCAPABILITIES_SOURCE_ROOT=${SOURCE_ROOT}" "-DCAPABILITIES_INFO=${failed_info}"
      -P "${SOURCE_ROOT}/tests/cmake/Capabilities.cmake"
    RESULT_VARIABLE failed_rc OUTPUT_VARIABLE failed_out ERROR_VARIABLE failed_err)
  if(NOT failed_rc STREQUAL "0")
    message(FATAL_ERROR "capability claims assertion: failed evidence controls errored: ${failed_out}${failed_err}")
  endif()
  file(STRINGS "${failed_info}" failed_info_lines)
  if(NOT "${failed_info_lines}" MATCHES "is_experimental = \"true\"")
    message(FATAL_ERROR "capability claims assertion: failed results cleared the experimental marker")
  endif()
  return()
endif()
