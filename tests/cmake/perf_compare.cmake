# SCHWAYSTATION_PERF_MODE=<gate|report> cmake -DFIXTURE=<name> -DHEAD=<n> -DBASE1=<n>
#   -DBASE2=<n> -DALLOW=<file> -DTODAY=<YYYY-MM-DD> [-DNO_BASE=true] -P perf_compare.cmake
# Fault prevented: a pull request slowing the core unnoticed. HEAD is Cachegrind Ir per
# frame, (Ir at 360 frames - Ir at 60) / 300; BASE1 and BASE2 measure the same fixture on the control.
# Fails above +1.00 % (or a dated allow line's cap) only in gate mode; bad input always.
cmake_minimum_required(VERSION 3.25)
function(perf_error reason)
  message(FATAL_ERROR "perf: error ${reason}")
endfunction()
include(${CMAKE_CURRENT_LIST_DIR}/date_days.cmake)
function(perf_number name)
  if(NOT "${${name}}" MATCHES "^[1-9][0-9]*$")
    perf_error("${name} '${${name}}' is not a measurement")
  endif()
endfunction()
set(mode "$ENV{SCHWAYSTATION_PERF_MODE}")
if(NOT FIXTURE MATCHES "^[A-Za-z0-9_.-]+$")
  perf_error("FIXTURE '${FIXTURE}' is not a fixture name")
endif()
if(NOT mode MATCHES "^(gate|report)$")
  perf_error("SCHWAYSTATION_PERF_MODE '${mode}' is not gate or report")
endif()
perf_number(HEAD)
if(NO_BASE STREQUAL "true" AND NOT "${BASE1}${BASE2}" STREQUAL "")
  perf_error("NO_BASE is true but a base was measured")
elseif(NOT NO_BASE STREQUAL "true")
  perf_number(BASE1)
  perf_number(BASE2)
endif()
if(NOT EXISTS "${ALLOW}")
  perf_error("allow file '${ALLOW}' does not exist")
endif()
schway_date_days(today "${TODAY}" perf_error FALSE)
# Allow lines: <fixture> <max % x 100> <expiry YYYY-MM-DD> <reason>. The reason is
# never printed, so list syntax in it is replaced before the text is split.
set(limit 100)
file(READ "${ALLOW}" text)
string(REGEX REPLACE "[][;\r]" "_" text "${text}")
string(REPLACE "\n" ";" lines "${text}")
set(n 0)
foreach(line IN LISTS lines)
  math(EXPR n "${n} + 1")
  if(line MATCHES "^[ \t_]*$" OR line MATCHES "^#")
    continue()
  endif()
  if(NOT line MATCHES "^([A-Za-z0-9_.-]+) (0|[1-9][0-9]*) ([0-9-]+) [^ ]")
    perf_error("malformed allow line ${n} of ${ALLOW}")
  endif()
  set(name ${CMAKE_MATCH_1})
  set(cap ${CMAKE_MATCH_2})
  schway_date_days(expiry "${CMAKE_MATCH_3}" perf_error FALSE)
  math(EXPR ahead "${expiry} - ${today}")
  # Applies from today through its expiry, at most 60 days away.
  if(name STREQUAL FIXTURE AND ahead GREATER_EQUAL 0 AND ahead LESS_EQUAL 60 AND cap GREATER limit)
    set(limit ${cap})
  endif()
endforeach()
if(NO_BASE STREQUAL "true")
  set(verdict NO_BASE)
  set(line "perf ${FIXTURE} head=${HEAD} base=none delta_bp=none verdict=NO_BASE")
else()
  math(EXPR delta "${HEAD} - ${BASE1}")
  # Truncated toward zero for the printed value; the decision below is exact.
  math(EXPR delta_bp "${delta} * 10000 / ${BASE1}")
  math(EXPR scaled "${delta} * 10000")
  math(EXPR allowed "${limit} * ${BASE1}")
  if(NOT BASE1 EQUAL BASE2)
    set(verdict UNSTABLE)
  elseif(scaled GREATER allowed)
    set(verdict FAIL)
  else()
    set(verdict PASS)
  endif()
  set(line "perf ${FIXTURE} head=${HEAD} base=${BASE1} delta_bp=${delta_bp} verdict=${verdict}")
endif()
message(NOTICE "${line}")
if(NOT verdict STREQUAL "PASS" AND mode STREQUAL "gate")
  message(FATAL_ERROR "perf: verdict ${verdict} in gate mode")
endif()
