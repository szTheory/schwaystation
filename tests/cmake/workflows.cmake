# cmake -DMODE=timeouts|pins -DDIR=<workflows directory> or -DCASE=spu_registration -DROOT=<root> -P workflows.cmake
# timeouts: every timeout-minutes line carries a comment naming the run it was
#   measured from ("run" and nine or more digits) or the word provisional.
#   Fault prevented: a job timeout guessed rather than measured.
# pins: every uses: line names a local ./path, or owner/repo[/path] at a full
#   40-hex commit followed by a "# v..." comment naming the release it is.
#   Fault prevented: an action referenced by a tag that can be moved under a release.
cmake_minimum_required(VERSION 3.25)
function(yaml_job_has file job)
  file(READ "${ROOT}/${file}" yaml)
  string(REGEX MATCH "\n  ${job}:\n(    [^\n]*\n|\n)*" block "${yaml}")
  string(REPLACE "\n" " " block "${block}")
  string(JOIN ".*" pattern ${ARGN})
  if(NOT block OR NOT block MATCHES "${pattern}")
    message(FATAL_ERROR "spu_registration: ${job} in ${file} lacks ${pattern}")
  endif()
endfunction()
if(CASE STREQUAL "spu_registration")
  yaml_job_has(.github/workflows/ci.yml ci-required "needs:.*hash-equality.*retroarch.*perf")
  yaml_job_has(.github/workflows/ci.yml hash-equality "COUNT=8")
  yaml_job_has(.github/workflows/ci.yml build "INVENTORY=tests/inventory/ci\\.txt.*fixtures/spu_tone\\.exe")
  yaml_job_has(.github/workflows/ci.yml retroarch
    "name: pad-counter-fixture.*PROBE_CONTENT=build/fixtures/spu_tone\\.exe.*run_retroarch\\.cmake.*--exe ../fixtures/spu_tone\\.exe --frames 59.*ra-spu-tone/system.*verify\\.py compare spu-tone-runner59\\.bmp spu-tone\\.59\\.bmp 256 240.*verify\\.py compare spu-tone-runner60\\.bmp spu-tone\\.60\\.bmp 256 240")
  yaml_job_has(.github/workflows/ci.yml perf "CASE=spu_idle")
  yaml_job_has(.github/workflows/ci.yml be32 "INVENTORY=tests/inventory/ci\\.txt" "LABELS=portable")
  yaml_job_has(.github/workflows/ci.yml wasm32 "INVENTORY=tests/inventory/wasm32\\.txt" "LABELS=portable")
  yaml_job_has(.github/workflows/nightly.yml vectors-full "cmake --workflow --preset nightly"
    "INVENTORY=tests/inventory/nightly\\.txt")
  file(READ "${ROOT}/tests/retroarch/test.cfg.in" config)
  if(NOT config MATCHES "audio_driver = \\\"null\\\"" OR NOT config MATCHES "audio_enable = \\\"false\\\"")
    message(FATAL_ERROR "spu_registration: RetroArch tone smoke must remain video-only")
  endif()
  include("${ROOT}/tests/cmake/inventory.cmake")
  schway_inventory_union("${ROOT}/tests/inventory/ci.txt" "${ROOT}/tests" ci_tests)
  schway_inventory_union("${ROOT}/tests/inventory/wasm32.txt" "${ROOT}/tests" wasm_tests)
  if(NOT ci_tests MATCHES "libretro\\.host[ \t].*libretro\\.host\\.pal[ \t].*runner\\.audio\\.failures[ \t].*runner\\.audio\\.hash[ \t].*spu\\.fixture[ \t]" OR
     NOT wasm_tests MATCHES "runner\\.audio\\.failures[ \t].*runner\\.audio\\.hash[ \t].*spu\\.fixture[ \t]")
    message(FATAL_ERROR "spu_registration: CI or wasm32 does not select the required tests")
  endif()
  schway_inventory_union("${ROOT}/tests/inventory/nightly.txt" "${ROOT}/tests" nightly_tests)
  if(NOT "${nightly_tests}" MATCHES "(^|;)spu\\.reference\\.memory_transfer[ \t]")
    message(FATAL_ERROR "spu_registration: nightly transfer inventory is missing")
  endif()
  file(STRINGS "${ROOT}/tests/nightly/tests.cmake" transfer REGEX "schway_add_test\\(NAME spu\\.reference\\.memory_transfer")
  file(STRINGS "${ROOT}/.github/workflows/nightly.yml" nightly_paths
    REGEX "^      - (cmake/SPUReferences\\.cmake|pins\\.txt|tests/nightly/inventory\\.txt|tests/nightly/tests\\.cmake|tests/spu/reference\\.c)$")
  if(NOT transfer OR NOT "${nightly_paths}" MATCHES
     "cmake/SPUReferences\\.cmake.*pins\\.txt.*tests/nightly/inventory\\.txt.*tests/nightly/tests\\.cmake.*tests/spu/reference\\.c")
    message(FATAL_ERROR "spu_registration: nightly SPU transfer test is disconnected")
  endif()
  message(STATUS "spu_registration: hosted and inventory wiring is connected")
  return()
endif()
string(REPEAT "[0-9]" 9 id)
string(REPEAT "[0-9a-f]" 40 sha)
if(MODE STREQUAL "timeouts")
  set(name timeout_comments)
  set(key timeout-minutes)
  set(want "without a run ID or provisional")
  set(pattern "^timeout-minutes:[^#]*#.*(provisional|runs? ${id})")
elseif(MODE STREQUAL "pins")
  set(name action_pins)
  set(key uses)
  set(want "not pinned to a commit with a # v comment")
  set(pattern "^uses: (\\./|[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@${sha} +# v[0-9])")
endif()
if(NOT DEFINED name OR "${DIR}" STREQUAL "")
  message(FATAL_ERROR "workflows: -DMODE=timeouts|pins and -DDIR=<dir> are required")
endif()
file(GLOB files "${DIR}/*.yml" "${DIR}/*.yaml")
set(seen 0)
foreach(file IN LISTS files)
  get_filename_component(base "${file}" NAME)
  file(STRINGS "${file}" lines REGEX "^[ \t-]*${key}:")
  foreach(line IN LISTS lines)
    math(EXPR seen "${seen} + 1")
    string(REGEX REPLACE "^[ \t-]*" "" line "${line}")
    if(NOT line MATCHES "${pattern}")
      list(APPEND bad "${name}: ${base}: ${line}")
    endif()
  endforeach()
endforeach()
list(LENGTH bad count)
if(count GREATER 0)
  list(JOIN bad "\n" bad)
  message(FATAL_ERROR "${bad}\n${name}: ${count} ${key}: lines ${want}")
endif()
if(seen EQUAL 0)
  message(FATAL_ERROR "${name}: no ${key}: line under ${DIR}")
endif()
message(STATUS "${name}: ${seen} ${key}: lines, none ${want}")
