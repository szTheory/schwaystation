# cmake -DMODE=timeouts|pins -DDIR=<dir> or -DCASE=spu_registration -DROOT=<root>; guards guessed timeouts and moved action refs.
cmake_minimum_required(VERSION 3.25)
if(MODE STREQUAL "capabilities")
  # Fault prevented: packaging before the completed capability report reaches .info.
  if(NOT DEFINED ROOT OR NOT EXISTS "${ROOT}/CMakePresets.json")
    message(FATAL_ERROR "capabilities workflow: -DROOT must contain CMakePresets.json")
  endif()
  file(READ "${ROOT}/CMakePresets.json" presets)
  string(JSON workflow_count LENGTH "${presets}" workflowPresets)
  math(EXPR workflow_last "${workflow_count} - 1")
  foreach(expected_profile IN ITEMS ci ci-msvc)
    set(found FALSE)
    foreach(workflow_index RANGE 0 ${workflow_last})
      string(JSON workflow_name GET "${presets}" workflowPresets ${workflow_index} name)
      if(workflow_name STREQUAL expected_profile)
        set(found TRUE)
        string(JSON step_count LENGTH "${presets}" workflowPresets ${workflow_index} steps)
        math(EXPR step_last "${step_count} - 1")
        set(actual_steps)
        foreach(step_index RANGE 0 ${step_last})
          string(JSON step_type GET "${presets}" workflowPresets ${workflow_index} steps ${step_index} type)
          string(JSON step_name GET "${presets}" workflowPresets ${workflow_index} steps ${step_index} name)
          list(APPEND actual_steps "${step_type}:${step_name}")
        endforeach()
        if(expected_profile STREQUAL "ci")
          set(expected_steps configure:ci build:ci test:ci package:ci test:ci-release)
        else()
          set(expected_steps configure:ci-msvc build:ci-msvc test:ci-msvc package:ci-msvc test:ci-msvc-release)
        endif()
        if(NOT "${actual_steps}" STREQUAL "${expected_steps}")
          message(FATAL_ERROR "capabilities workflow: ${expected_profile} must test before packaging and release tests")
        endif()
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "capabilities workflow: ${expected_profile} workflow is missing")
    endif()
  endforeach()
  file(READ "${ROOT}/libretro/CMakeLists.txt" libretro_cmake)
  string(FIND "${libretro_cmake}" "install(CODE" install_hook_position)
  string(FIND "${libretro_cmake}" "install(FILES" info_install_position)
  if(install_hook_position LESS 0 OR info_install_position LESS 0)
    message(FATAL_ERROR "capabilities workflow: libretro install hook or staged .info copy is missing")
  elseif(install_hook_position GREATER_EQUAL info_install_position)
    message(FATAL_ERROR "capabilities workflow: the libretro install hook must precede the staged .info copy")
  endif()
  math(EXPR hook_length "${info_install_position} - ${install_hook_position}")
  string(SUBSTRING "${libretro_cmake}" ${install_hook_position} ${hook_length} install_hook)
  string(FIND "${libretro_cmake}" "CAPABILITIES_JUNIT" report_arg_position)
  string(FIND "${install_hook}" "COMPONENT libretro" component_position)
  if(report_arg_position LESS 0 OR component_position LESS 0)
    message(FATAL_ERROR "capabilities workflow: the libretro component install hook must import the completed JUnit report")
  endif()
  message(STATUS "capabilities workflow: ci and ci-msvc test before package; libretro import precedes staged .info copy")
  return()
endif()
function(yaml_job_has file job)
  file(READ "${ROOT}/${file}" yaml)
  string(REGEX MATCH "\n  ${job}:\n(    [^\n]*\n|\n)*" block "${yaml}")
  string(REPLACE "\n" " " block "${block}")
  string(JOIN ".*" pattern ${ARGN})
  if(NOT block OR NOT block MATCHES "${pattern}" OR
     (CASE STREQUAL "disc_registration" AND file STREQUAL ".github/workflows/ci.yml" AND NOT yaml MATCHES "cmake --build --preset asan --target schwaystation-disc-fixtures schwaystation-legacy-disc-fixtures"))
    message(FATAL_ERROR "${CASE}: ${job} in ${file} lacks ${pattern}")
  endif()
endfunction()
