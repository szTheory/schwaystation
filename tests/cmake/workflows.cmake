# cmake -DMODE=timeouts|pins -DDIR=<dir> or -DCASE=spu_registration -DROOT=<root>; guards guessed timeouts and moved action refs.
cmake_minimum_required(VERSION 3.25)
function(yaml_job_has file job)
  file(READ "${ROOT}/${file}" yaml)
  string(REGEX MATCH "\n  ${job}:\n(    [^\n]*\n|\n)*" block "${yaml}")
  string(REPLACE "\n" " " block "${block}")
  string(JOIN ".*" pattern ${ARGN})
  if(NOT block OR NOT block MATCHES "${pattern}" OR CASE STREQUAL "disc_registration" AND file STREQUAL ".github/workflows/ci.yml" AND NOT yaml MATCHES "cmake --build --preset asan --target schwaystation-disc-fixtures schwaystation-legacy-disc-fixtures")
    message(FATAL_ERROR "${CASE}: ${job} in ${file} lacks ${pattern}")
  endif()
endfunction()
if(CASE STREQUAL "spu_registration" OR CASE STREQUAL "disc_registration")
  yaml_job_has(.github/workflows/ci.yml changes "Cheap source, inventory and route preflight.*MODE=pins.*MODE=timeouts.*line_budget[.]cmake.*sort -cu.*CASE=disc_registration")
  yaml_job_has(.github/workflows/ci.yml ci-required "needs:.*hash-equality.*retroarch.*perf")
  yaml_job_has(.github/workflows/ci.yml build "path: compat-base.*sparse-checkout:.*scripts/compat-ratchet[.]sh.*tests/cmake/compat-ratchet[.]cmake.*tests/cmake/date_days[.]cmake.*tests/compat/ledger[.]csv")
  yaml_job_has(.github/workflows/ci.yml hash-equality "COUNT=8")
  yaml_job_has(.github/workflows/ci.yml retroarch "name: pad-counter-fixture.*Required RetroArch guests exist.*memcard_roundtrip\\.exe.*schwaystation-disc-fixtures.*RetroArch saves and resumes both cards.*ra-cards.*PROBE_CONTENT=build/fixtures/memcard_roundtrip\\.exe.*MODE=cards.*run_retroarch\\.cmake.*--exe ../fixtures/spu_tone\\.exe --frames 59.*ra-spu-tone/system.*verify\\.py compare spu-tone-runner59\\.bmp spu-tone\\.59\\.bmp 256 240.*verify\\.py compare spu-tone-runner60\\.bmp spu-tone\\.60\\.bmp 256 240.*CONTENT=build/ci/fixtures/disc_boot\\.cue.*--disc ../ci/fixtures/disc_boot\\.cue.*verify\\.py compare disc-runner\\.bmp disc\\.bmp 16 16")
  yaml_job_has(.github/workflows/ci.yml perf "github.event_name == 'pull_request'.*workflow_dispatch.*inputs[.]control_ref != ''.*timeout-minutes: 10.*run 44600162797.*run 44218206100.*CASE=spu_idle.*CASE=cd_idle")
  yaml_job_has(.github/workflows/ci.yml build "name: Stable state size preflight.*cmake --build build/ci --target schwaystation-test-state.*QUALITY_STATE_BYTES_BEGIN.*name: Build legacy disc image fixtures.*cmake --preset.*cmake --build build/.*schwaystation-legacy-disc-fixtures.*name: Build, test, package.*cmake --workflow --preset.*INVENTORY=tests/inventory/ci\\.txt.*fixtures/spu_tone\\.exe")
  yaml_job_has(.github/workflows/ci.yml build "name: pad-counter-fixture.*fixtures/memcard_roundtrip\\.exe")
  yaml_job_has(.github/workflows/ci.yml be32 "cmake --preset chd-tool.*build/be32/tests/schwaystation-chd-tool.*cmake --preset be32-chd.*disc_boot[.]chd[.]manifest.*CHDFixtures[.]cmake.*cmake --build --preset be32-chd.*ctest --preset be32-chd" "INVENTORY=tests/inventory/ci\\.txt" "LABELS=portable" "schwaystation-disc-fixtures schwaystation-legacy-disc-fixtures")
  yaml_job_has(.github/workflows/ci.yml wasm32 "cmake --preset chd-tool.*build/wasm32/tests/schwaystation-chd-tool.*cmake --preset wasm32-chd.*disc_boot[.]chd[.]manifest.*CHDFixtures[.]cmake.*cmake --build build/wasm32 --target schwaystation-run.*QUALITY_WASM_COMPARE_BEGIN.*name: Build WASI portable test targets.*cmake --build --preset wasm32-chd.*ctest --preset wasm32-preflight.*ctest --preset wasm32-chd" "INVENTORY=tests/inventory/wasm32\\.txt" "LABELS=portable" "schwaystation-disc-fixtures schwaystation-legacy-disc-fixtures")
  yaml_job_has(.github/workflows/nightly.yml vectors-full "needs: changes.*if:.*nightly_full"
    "cmake --workflow --preset nightly" "INVENTORY=tests/inventory/nightly\\.txt")
  yaml_job_has(.github/workflows/nightly.yml changes "permissions:.*pull-requests: read.*nightly_full:.*pbp_only:.*full=true.*pbp=false.*gh api --paginate --slurp.*per_page=100.*previous_filename.*classify-changes[.]sh")
  yaml_job_has(.github/workflows/nightly.yml bench "needs: changes.*!cancelled.*github.event_name != 'pull_request'.*needs[.]changes[.]result != 'success'.*nightly_full")
  yaml_job_has(.github/workflows/nightly.yml bench-wasm32 "needs: changes.*!cancelled.*github.event_name != 'pull_request'.*needs[.]changes[.]result != 'success'.*nightly_full")
  yaml_job_has(.github/workflows/nightly.yml fuzz "needs: changes.*!cancelled.*github.event_name != 'pull_request'.*needs[.]changes[.]result != 'success'.*nightly_full == 'true' [|][|] needs[.]changes[.]outputs[.]pbp_only == 'true'" "name: Sanitizer and media-fixture dependencies.*packages=\\(libclang-rt-21-dev libavformat-dev libavcodec-dev libavutil-dev libswresample-dev libswscale-dev\\).*cmake --preset chd-tool.*cmake --build --preset chd-tool.*Build owned CHD and PBP baseline fixtures.*cmake --preset fuzz.*cmake --build build/fuzz --target schwaystation-disc-fixtures schwaystation-pbp-fixtures schwaystation-legacy-disc-fixtures schwaystation-test-disc-legacy.*CHDFixtures[.]cmake" "Configure PBP-only sanitizer targets.*CHD=OFF.*schwaystation-fuzz-pbp schwaystation-fuzz-pbp-replay schwaystation-pbp-fixtures.*else.*cmake --build --preset fuzz.*cmake --build build/fuzz --target schwaystation-test-disc-media.*fi" "Verify ECM and CCD fixture and replay closure.*build/fuzz/fixtures/disc_boot_legacy_literal[.]ecm.*build/fuzz/fixtures/disc_boot_legacy_modeled[.]ecm.*build/fuzz/fixtures/disc_boot_legacy[.]ccd.*build/fuzz/fixtures/disc_boot_legacy[.]img.*build/fuzz/fixtures/disc_boot_legacy[.]sub.*ctest --test-dir build/fuzz.*disc\\[.]image\\[.]legacy_.*\\[.]regress\\[.].*chd\\[.]seed_corpus.*Check media seeds and run bounded campaigns.*subsystems=\\(cue cnf m3u cdrom chd mdec pbp ecm ccd\\).*expected=\\(5 5 7 15 12 6 14 10 10\\).*max_lengths=\\(65536 4096 65536 16384 16384 262144 256 2101249 65536\\)" "seed_output=.*seed_cap=2099201.*seed_fixtures=disc_boot_legacy_literal[.]ecm,disc_boot_legacy_modeled[.]ecm.*valid_literal valid_modeled bad_magic varint_overflow record_limit decoded_extent modeled_type1 bad_terminator bad_edc truncated_tail.*seed_cap=65541.*seed_fixtures=disc_boot_legacy[.]ccd,disc_boot_legacy[.]img,disc_boot_legacy[.]sub.*valid_sub_transpose duplicate_field unsupported_session duplicate_mode plba_index_conflict missing_image short_image short_sub companion_scope valid_repeat.*seed_count=.*file_cap=.*fixtures=.*seed_bytes=.*test.*done.*if.*PBP_ONLY.*schwaystation-fuzz-exe -max_total_time=60")
  file(READ "${ROOT}/cmake/DiscFixtures.cmake" media_rules)
  string(REPLACE "\n" " " media_rules "${media_rules}")
  string(REGEX MATCH "add_custom_command\\(OUTPUT[^)]*media[.]sha256[^)]*\\)" media_command "${media_rules}")
  if(NOT media_command MATCHES "BYPRODUCTS .*cdda[.]wav.*movie[.]str.*xa[.]xa")
    message(FATAL_ERROR "${CASE}: generated disc media lack declared byproducts")
  endif()
  file(READ "${ROOT}/tests/retroarch/test.cfg.in" config)
  if(NOT config MATCHES "audio_driver = \\\"null\\\"" OR NOT config MATCHES "audio_enable = \\\"false\\\"")
    message(FATAL_ERROR "${CASE}: RetroArch tone smoke must remain video-only")
  endif()
  include("${ROOT}/tests/cmake/inventory.cmake")
  schway_inventory_union("${ROOT}/tests/inventory/ci.txt" "${ROOT}/tests" ci_tests)
  schway_inventory_union("${ROOT}/tests/inventory/wasm32.txt" "${ROOT}/tests" wasm_tests)
  if(NOT ci_tests MATCHES "disc\\.fixture\\.fmv[ \t].*libretro\\.host[ \t].*libretro\\.host\\.pal[ \t].*runner\\.audio\\.failures[ \t].*runner\\.audio\\.hash[ \t].*spu\\.fixture[ \t]" OR
     NOT wasm_tests MATCHES "disc\\.fixture\\.fmv[ \t].*runner\\.audio\\.failures[ \t].*runner\\.audio\\.hash[ \t].*spu\\.fixture[ \t]")
    message(FATAL_ERROR "${CASE}: CI or wasm32 does not select the required tests")
  endif()
  schway_inventory_union("${ROOT}/tests/inventory/nightly.txt" "${ROOT}/tests" nightly_tests)
  if(NOT "${nightly_tests}" MATCHES "(^|;)cdrom\\.reference\\.getloc[ \t].*(^|;)cdrom\\.reference\\.timing[ \t].*(^|;)mdec\\.reference\\.4bit[ \t].*(^|;)mdec\\.reference\\.8bit_regression[ \t].*(^|;)spu\\.reference\\.memory_transfer[ \t]")
    message(FATAL_ERROR "media_registration: a nightly SPU/CD-ROM/MDEC reference is missing")
  endif()
  file(STRINGS "${ROOT}/tests/nightly/tests.cmake" transfer REGEX "schway_add_test\\(NAME spu\\.reference\\.memory_transfer")
  file(STRINGS "${ROOT}/.github/workflows/nightly.yml" nightly_path_filter REGEX "^    paths:")
  if(NOT transfer OR nightly_path_filter)
    message(FATAL_ERROR "${CASE}: nightly transfer must stay registered and routing must use the changes job")
  endif()
  message(STATUS "${CASE}: hosted and inventory wiring is connected")
  return()
endif()
string(REPEAT "[0-9]" 9 id)
string(REPEAT "[0-9a-f]" 40 sha)
if(MODE STREQUAL "timeouts")
  set(name timeout_comments)
  set(key timeout-minutes)
  set(want "without a run ID or provisional")
  set(pattern "^timeout-minutes:[^#]*#.*(provisional|runs? ${id})")
elseif(MODE STREQUAL "pins")
  set(name action_pins)
  set(key uses)
  set(want "not pinned to a commit with a # v comment")
  set(pattern "^uses: (\\./|[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@${sha} +# v[0-9])")
endif()
if(NOT DEFINED name OR "${DIR}" STREQUAL "")
  message(FATAL_ERROR "workflows: -DMODE=timeouts|pins and -DDIR=<dir> are required")
endif()
file(GLOB files "${DIR}/*.yml" "${DIR}/*.yaml")
set(seen 0)
foreach(file IN LISTS files)
  get_filename_component(base "${file}" NAME)
  file(STRINGS "${file}" lines REGEX "^[ \t-]*${key}:")
  foreach(line IN LISTS lines)
    math(EXPR seen "${seen} + 1")
    string(REGEX REPLACE "^[ \t-]*" "" line "${line}")
    if(NOT line MATCHES "${pattern}")
      list(APPEND bad "${name}: ${base}: ${line}")
    endif()
  endforeach()
endforeach()
list(LENGTH bad count)
if(count GREATER 0)
  list(JOIN bad "\n" bad)
  message(FATAL_ERROR "${bad}\n${name}: ${count} ${key}: lines ${want}")
endif()
if(seen EQUAL 0)
  message(FATAL_ERROR "${name}: no ${key}: line under ${DIR}")
endif()
message(STATUS "${name}: ${seen} ${key}: lines, none ${want}")
