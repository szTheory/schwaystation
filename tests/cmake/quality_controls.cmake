set(stub_bin "${BIN}/stub-bin")
file(MAKE_DIRECTORY "${stub_bin}")
file(WRITE "${stub_bin}/gh" "#!/bin/sh\n[ \"$1 $2 $3\" = 'api --paginate --slurp' ] || exit 9\nprintf '%s\\n' \"$4\" > \"$GH_CAPTURE\"\ncat \"$GH_PAGES\"\n")
file(WRITE "${stub_bin}/sleep" "#!/bin/sh\nexit 0\n")
file(CHMOD "${stub_bin}/gh" "${stub_bin}/sleep" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(needs_success "{\"changes\":{\"result\":\"success\"},\"hygiene\":{\"result\":\"success\"},\"title\":{\"result\":\"success\"},\"openbios\":{\"result\":\"success\"},\"build\":{\"result\":\"success\"}}")
set(needs_release_success "{\"changes\":{\"result\":\"success\"},\"hygiene\":{\"result\":\"success\"},\"title\":{\"result\":\"success\"},\"openbios\":{\"result\":\"success\"},\"build\":{\"result\":\"success\"},\"rehearsal\":{\"result\":\"success\"},\"cleanup\":{\"result\":\"success\"}}")
set(needs_failed "{\"changes\":{\"result\":\"success\"},\"hygiene\":{\"result\":\"success\"},\"title\":{\"result\":\"success\"},\"openbios\":{\"result\":\"failure\"},\"build\":{\"result\":\"success\"}}")
set(needs_skipped "{\"changes\":{\"result\":\"success\"},\"hygiene\":{\"result\":\"success\"},\"title\":{\"result\":\"skipped\"},\"gpu-reference\":{\"result\":\"skipped\"},\"build\":{\"result\":\"skipped\"},\"perf\":{\"result\":\"skipped\"},\"rehearsal\":{\"result\":\"skipped\"},\"cleanup\":{\"result\":\"skipped\"}}")
function(gate_case name pages needs expected)
  set(release_inputs false)
  if(ARGC GREATER 4)
    set(release_inputs "${ARGV4}")
  endif()
  file(WRITE "${BIN}/gh-pages.json" "${pages}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=${stub_bin}:$ENV{PATH}" "GH_PAGES=${BIN}/gh-pages.json" "GH_CAPTURE=${BIN}/gh-capture" "NEEDS=${needs}" "EVENT=pull_request" "HEAVY=true" "CALLED=false" "RELEASE_INPUTS=${release_inputs}" "GITHUB_REPOSITORY=owner/repo" "GITHUB_SHA=${head_sha}" "GITHUB_PR_HEAD_SHA=${pr_head_sha}" "GITHUB_RUN_ID=123" "GITHUB_RUN_ATTEMPT=2" "GITHUB_EVENT_NAME=pull_request" "GITHUB_HEAD_REF=phase/07-test" "RUNNER_TEMP=${BIN}" "CI_HEAVY=true" "CI_CALLED=false" "CI_RELEASE_INPUTS=${release_inputs}" "CI_INPUT_ROOT=${input_root}" "CI_TESTING=true" "QUALITY_FILE=${quality_file}" "${SH}" "${gate_script}" WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if((expected STREQUAL "pass" OR expected STREQUAL "unbaselined") AND NOT rc STREQUAL "0")
    message(FATAL_ERROR "quality_controls: ${name} required job failed: ${out}${err}")
  elseif(expected STREQUAL "pass" AND NOT "${out}${err}" MATCHES "comparable workload passed")
    message(FATAL_ERROR "quality_controls: ${name} did not compare the matching workload: ${out}${err}")
  elseif(expected STREQUAL "fail" AND rc STREQUAL "0")
    message(FATAL_ERROR "quality_controls: ${name} required job accepted invalid input")
  elseif(NOT expected STREQUAL "pass" AND NOT expected STREQUAL "fail" AND NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "quality_controls: ${name} required job did not report ${expected}: ${out}${err}")
  endif()
endfunction()
gate_case(required_match "${good_pages}" "${needs_success}" pass)
gate_case(required_release_input_route "${release_pages}" "${needs_release_success}" unbaselined true)
file(READ "${BIN}/gh-capture" api_endpoint)
if(NOT api_endpoint MATCHES "attempts/2/jobs[?]per_page=100")
  message(FATAL_ERROR "quality_controls: gh did not request the exact current attempt")
endif()
gate_case(required_over "${over_pages}" "${needs_success}" "above ceiling")
gate_case(required_mismatch "${changed_pages}" "${needs_success}" unbaselined)
gate_case(required_missing "${missing_job}" "${needs_success}" fail)
gate_case(required_malformed "not-json" "${needs_success}" fail)
gate_case(required_stale "${stale_job}" "${needs_success}" fail)
gate_case(required_predecessor_failure "${good_pages}" "${needs_failed}" fail)
file(WRITE "${BIN}/rollup-only.sh" "set -eu\n${rollup_block}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "NEEDS=${needs_skipped}" "EVENT=push" "HEAVY=false" "CALLED=false" "RELEASE_INPUTS=false" "${SH}" "${BIN}/rollup-only.sh" WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE skip_rc)
if(NOT skip_rc STREQUAL "0")
  message(FATAL_ERROR "quality_controls: existing permitted skip paths no longer pass")
endif()
