# Fault prevented: stale, incomplete, or unsupported evidence clearing the
# libretro experimental marker.
cmake_minimum_required(VERSION 3.25)

function(schway_capabilities_source_material source_root output_material output_digest output_files)
  set(inputs CMakeLists.txt CMakePresets.json pins.txt .github/workflows/ci.yml
      tests/compat/required-capabilities.csv tests/libretro/inventory.txt tests/compat/inventory.txt)
  set(configure_files)
  foreach(root IN ITEMS cmake src include host runner libretro scripts tests third_party)
    if(IS_DIRECTORY "${source_root}/${root}")
      if(CMAKE_SCRIPT_MODE_FILE)
        file(GLOB_RECURSE root_inputs LIST_DIRECTORIES FALSE RELATIVE "${source_root}"
          "${source_root}/${root}/*")
      else()
        file(GLOB_RECURSE root_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE
          RELATIVE "${source_root}" "${source_root}/${root}/*")
      endif()
      foreach(input IN LISTS root_inputs)
        if(input MATCHES "[.](c|h|inc|cmake|txt|csv|in|json|py|sh)$" OR input MATCHES "^tests/fixtures/")
          list(APPEND inputs "${input}")
        endif()
      endforeach()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES inputs)
  list(SORT inputs)
  set(material "")
  foreach(input IN LISTS inputs)
    if(EXISTS "${source_root}/${input}" AND NOT IS_DIRECTORY "${source_root}/${input}")
      file(SHA256 "${source_root}/${input}" digest)
      string(APPEND material "${input}=${digest}\n")
      list(APPEND configure_files "${source_root}/${input}")
    endif()
  endforeach()
  string(SHA256 digest "${material}")
  set(${output_material} "${material}" PARENT_SCOPE)
  set(${output_digest} "${digest}" PARENT_SCOPE)
  set(${output_files} "${configure_files}" PARENT_SCOPE)
endfunction()

function(schway_capabilities_validate_matrix matrix output_count)
  if(NOT EXISTS "${matrix}")
    message(FATAL_ERROR "capabilities: required matrix is missing")
  endif()
  file(STRINGS "${matrix}" rows)
  list(POP_FRONT rows header)
  if(NOT header STREQUAL "id,group,subject,predicate,selector,required_if")
    message(FATAL_ERROR "capabilities: invalid matrix header")
  endif()
  set(expected)
  foreach(provider IN ITEMS iso raw-cue m3u-selection m3u-control pbp ecm ccd chd)
    if(provider STREQUAL "raw-cue")
      set(subject raw_cue)
    elseif(provider STREQUAL "m3u-selection")
      set(subject m3u_selection)
    elseif(provider STREQUAL "m3u-control")
      set(subject m3u_control)
    else()
      set(subject "${provider}")
    endif()
    set(condition always)
    if(provider STREQUAL "chd")
      set(condition chd)
    endif()
    list(APPEND expected "provider.${provider},provider,${subject},boot_input_picture_audio,compat.play.provider.${provider},${condition}")
  endforeach()
  set(regions ntsc-j ntsc-u pal)
  set(boards "pu7|1" "pu8-early|1" "pu8-late|0" "pu18|0" "pu20|0"
      "pu22|0" "pu23|0" "pm41|0" "pm41-2|0")
  foreach(region IN LISTS regions)
    foreach(entry IN LISTS boards)
      string(REPLACE "|" ";" fields "${entry}")
      list(GET fields 0 board)
      list(GET fields 1 gpu)
      list(APPEND expected "profile.${region}.${board}.gpu${gpu},profile,${region}/${board}/gpu${gpu},boot_input_picture_audio,compat.play.profile.${region}.${board}.gpu${gpu},always")
    endforeach()
  endforeach()
  set(peripherals
    "digital|libretro.input.controls"
    "dualshock|libretro.input.controls"
    "mouse|libretro.input.special"
    "negcon|libretro.input.special"
    "jogcon|libretro.input.special"
    "flight|libretro.input.special"
    "guncon|libretro.input.lightgun"
    "justifier|libretro.input.lightgun"
    "multitap|libretro.input.multitap")
  foreach(entry IN LISTS peripherals)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 peripheral)
    list(GET fields 1 selector)
    list(APPEND expected "peripheral.${peripheral},peripheral,${peripheral},device_behavior,${selector},always")
  endforeach()
  list(APPEND expected "card.persistence,card,memory-card,write_reload_read,libretro.cards.persistence,always")
  foreach(patch IN ITEMS ppf1 ppf2 ppf3 bps)
    list(APPEND expected "patch.${patch},patch,${patch},deterministic_patch,disc.patch.${patch},always")
  endforeach()
  list(APPEND expected "cheat.gs30,cheat,30,frame_write_and_state,libretro.cheats.apply,always")
  list(APPEND expected "cheat.gs80,cheat,80,frame_write_and_state,libretro.cheats.state,always")
  list(SORT expected)
  set(actual "${rows}")
  list(LENGTH expected expected_count)
  list(LENGTH actual actual_count)
  if(NOT actual_count EQUAL expected_count OR NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "capabilities: required matrix rows differ (expected ${expected_count}, found ${actual_count})")
  endif()
  set(${output_count} "${actual_count}" PARENT_SCOPE)
endfunction()

function(schway_capabilities_evaluate matrix results fingerprint configuration output_eligible)
  schway_capabilities_validate_matrix("${matrix}" row_count)
  set(eligible TRUE)
  if(NOT EXISTS "${results}")
    set(eligible FALSE)
  else()
    file(STRINGS "${matrix}" matrix_rows)
    file(STRINGS "${results}" result_rows)
    list(POP_FRONT matrix_rows)
    list(POP_FRONT result_rows result_header)
    if(NOT result_header STREQUAL "id,fingerprint,configuration,producer,predicate,status,evidence")
      set(eligible FALSE)
    endif()
    set(seen)
    foreach(result IN LISTS result_rows)
      string(REPLACE "," ";" values "${result}")
      list(LENGTH values value_count)
      if(NOT value_count EQUAL 7)
        set(eligible FALSE)
        continue()
      endif()
      list(GET values 0 id)
      if(id IN_LIST seen)
        set(eligible FALSE)
      endif()
      list(APPEND seen "${id}")
      set(matrix_index -1)
      foreach(matrix_candidate IN LISTS matrix_rows)
        string(REPLACE "," ";" candidate_fields "${matrix_candidate}")
        list(GET candidate_fields 0 candidate_id)
        if(candidate_id STREQUAL id)
          set(matrix_index 0)
          set(matrix_row "${matrix_candidate}")
          break()
        endif()
      endforeach()
      if(matrix_index EQUAL -1)
        set(eligible FALSE)
        continue()
      endif()
      string(REPLACE "," ";" fields "${matrix_row}")
      list(GET fields 3 expected_predicate)
      list(GET fields 4 expected_producer)
      list(GET fields 5 condition)
      list(GET values 1 actual_fingerprint)
      list(GET values 2 actual_configuration)
      list(GET values 3 actual_producer)
      list(GET values 4 actual_predicate)
      list(GET values 5 status)
      list(GET values 6 evidence)
      if(condition STREQUAL "chd" AND NOT configuration MATCHES "(^|[|])chd=on([|]|$)")
        continue()
      endif()
      if(NOT actual_fingerprint STREQUAL fingerprint OR
         NOT actual_configuration STREQUAL configuration OR
         NOT actual_producer STREQUAL expected_producer OR
         NOT actual_predicate STREQUAL expected_predicate OR
         NOT status STREQUAL "pass" OR evidence STREQUAL "")
        set(eligible FALSE)
      endif()
    endforeach()
    foreach(row IN LISTS matrix_rows)
      string(REPLACE "," ";" fields "${row}")
      list(GET fields 0 id)
      list(GET fields 5 condition)
      if(condition STREQUAL "chd" AND NOT configuration MATCHES "(^|[|])chd=on([|]|$)")
        continue()
      endif()
      if(NOT id IN_LIST seen)
        set(eligible FALSE)
      endif()
    endforeach()
  endif()
  set(${output_eligible} "${eligible}" PARENT_SCOPE)
endfunction()

function(schway_capabilities_import_junit matrix junit fingerprint configuration configured_at output)
  set(source_current TRUE)
  if(ARGC GREATER 6)
    set(source_current "${ARGV6}")
  endif()
  schway_capabilities_validate_matrix("${matrix}" row_count)
  set(fresh FALSE)
  if(EXISTS "${junit}")
    file(TIMESTAMP "${junit}" report_time "%Y-%m-%dT%H:%M:%SZ" UTC)
    if(report_time STRGREATER configured_at)
      file(READ "${junit}" report)
      string(REGEX MATCH "</testsuite>[ \t\r\n]*$" fresh "${report}")
    endif()
  endif()
  if(fresh AND source_current)
    string(REPLACE "\n" " " report "${report}")
    if(report MATCHES "<(failure|error|skipped)([ >])")
      set(report_status failed)
    else()
      set(report_status pass)
    endif()
  endif()
  set(candidate "${output}.tmp")
  file(WRITE "${candidate}" "id,fingerprint,configuration,producer,predicate,status,evidence\n")
  file(STRINGS "${matrix}" rows)
  list(POP_FRONT rows)
  foreach(row IN LISTS rows)
    string(REPLACE "," ";" fields "${row}")
    list(GET fields 0 id)
    list(GET fields 3 predicate)
    list(GET fields 4 selector)
    set(status unknown)
    set(evidence "junit:missing-or-stale")
    if(NOT source_current)
      set(evidence "junit:source-changed-since-configure")
    elseif(fresh)
      string(REPLACE "." "[.]" escaped_selector "${selector}")
      string(REGEX MATCHALL "<testcase[^>]*name=\"${escaped_selector}\"[^>]*>" matches "${report}")
      list(LENGTH matches match_count)
      if(match_count EQUAL 1 AND report_status STREQUAL "pass")
        set(status pass)
        set(evidence "junit:${selector}")
      elseif(match_count GREATER 1)
        set(status unknown)
        set(evidence "junit:duplicate:${selector}")
      elseif(match_count EQUAL 1)
        set(status fail)
        set(evidence "junit:failed:${selector}")
      endif()
    endif()
    file(APPEND "${candidate}" "${id},${fingerprint},${configuration},${selector},${predicate},${status},${evidence}\n")
  endforeach()
  file(RENAME "${candidate}" "${output}")
endfunction()

function(schway_capabilities_configure output_experimental)
  set(matrix "${PROJECT_SOURCE_DIR}/tests/compat/required-capabilities.csv")
  schway_capabilities_validate_matrix("${matrix}" row_count)
  schway_capabilities_source_material("${PROJECT_SOURCE_DIR}" material source_digest configure_inputs)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${configure_inputs})
  if(SCHWAYSTATION_INFO_CHD)
    set(chd_closure on)
  else()
    set(chd_closure off)
  endif()
  if(SCHWAYSTATION_CHD)
    set(chd_option on)
  else()
    set(chd_option off)
  endif()
  set(configuration "generator=${CMAKE_GENERATOR}|type=${CMAKE_BUILD_TYPE}|system=${CMAKE_SYSTEM_NAME}|processor=${CMAKE_SYSTEM_PROCESSOR}|c=${CMAKE_C_COMPILER_ID}-${CMAKE_C_COMPILER_VERSION}|cxx=${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}|chd=${chd_closure}|chd_option=${chd_option}")
  get_cmake_property(cache_variables CACHE_VARIABLES)
  list(SORT cache_variables)
  foreach(name IN LISTS cache_variables)
    if(name MATCHES "^(SCHWAYSTATION_|CHD)|^CMAKE_(C|CXX)_(FLAGS|COMPILER)|^CMAKE_TOOLCHAIN_FILE")
      string(APPEND configuration "|${name}=${${name}}")
    endif()
  endforeach()
  string(REPLACE "%" "%25" configuration "${configuration}")
  string(REPLACE ";" "%3B" configuration "${configuration}")
  string(REPLACE "," "%2C" configuration "${configuration}")
  string(REPLACE "\n" "%0A" configuration "${configuration}")
  string(SHA256 fingerprint "${material}${configuration}")
  set(config_file "${PROJECT_BINARY_DIR}/compat/capabilities-config.csv")
  file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/compat")
  string(TIMESTAMP configured_at "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(WRITE "${config_file}" "fingerprint,configuration,source_digest,configured_at\n${fingerprint},${configuration},${source_digest},${configured_at}\n")
  set(results "${PROJECT_BINARY_DIR}/compat/capabilities-results.csv")
  set(junit "${PROJECT_BINARY_DIR}/junit.xml")
  file(REMOVE "${results}")
  schway_capabilities_evaluate("${matrix}" "${results}" "${fingerprint}" "${configuration}" eligible)
  if(eligible)
    set(${output_experimental} false PARENT_SCOPE)
  else()
    set(${output_experimental} true PARENT_SCOPE)
  endif()
  set(SCHWAYSTATION_CAPABILITIES_CONFIG "${config_file}" PARENT_SCOPE)
  set(SCHWAYSTATION_CAPABILITIES_JUNIT "${junit}" PARENT_SCOPE)
  set(SCHWAYSTATION_CAPABILITIES_RESULTS "${results}" PARENT_SCOPE)
  set(SCHWAYSTATION_CAPABILITIES_SOURCE_DIGEST "${source_digest}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED CAPABILITIES_VALIDATE_MATRIX)
  schway_capabilities_validate_matrix("${CAPABILITIES_VALIDATE_MATRIX}" validated_rows)
  message(STATUS "capabilities: validated ${validated_rows} complete required rows")
endif()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED CAPABILITIES_MATRIX)
  foreach(required CAPABILITIES_MATRIX CAPABILITIES_CONFIG CAPABILITIES_SOURCE_ROOT)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
      message(FATAL_ERROR "capabilities: script mode requires existing ${required}")
    endif()
  endforeach()
  if(NOT DEFINED CAPABILITIES_OUTPUT OR "${CAPABILITIES_OUTPUT}" STREQUAL "")
    message(FATAL_ERROR "capabilities: script mode requires CAPABILITIES_OUTPUT")
  endif()
  get_filename_component(output_directory "${CAPABILITIES_OUTPUT}" DIRECTORY)
  if(NOT output_directory STREQUAL "" AND NOT IS_DIRECTORY "${output_directory}")
    file(MAKE_DIRECTORY "${output_directory}")
  endif()
  if(NOT DEFINED CAPABILITIES_JUNIT OR "${CAPABILITIES_JUNIT}" STREQUAL "")
    set(CAPABILITIES_JUNIT "${CAPABILITIES_CONFIG}.missing-junit")
  endif()
  file(STRINGS "${CAPABILITIES_CONFIG}" config_rows)
  list(POP_FRONT config_rows)
  list(GET config_rows 0 config_row)
  string(REPLACE "," ";" config_values "${config_row}")
  list(LENGTH config_values config_count)
  if(NOT config_count EQUAL 4)
    message(FATAL_ERROR "capabilities: malformed configure fingerprint")
  endif()
  list(GET config_values 0 fingerprint)
  list(GET config_values 1 configuration)
  list(GET config_values 2 configured_source_digest)
  list(GET config_values 3 configured_at)
  schway_capabilities_source_material("${CAPABILITIES_SOURCE_ROOT}" current_material current_source_digest current_source_files)
  if(configured_source_digest STREQUAL current_source_digest)
    set(source_current TRUE)
  else()
    set(source_current FALSE)
  endif()
  schway_capabilities_import_junit("${CAPABILITIES_MATRIX}" "${CAPABILITIES_JUNIT}"
    "${fingerprint}" "${configuration}" "${configured_at}" "${CAPABILITIES_OUTPUT}" "${source_current}")
  schway_capabilities_evaluate("${CAPABILITIES_MATRIX}" "${CAPABILITIES_OUTPUT}"
    "${fingerprint}" "${configuration}" eligible)
  if(DEFINED CAPABILITIES_INFO AND EXISTS "${CAPABILITIES_INFO}")
    file(READ "${CAPABILITIES_INFO}" info)
    if(eligible)
      string(REPLACE "is_experimental = \"true\"" "is_experimental = \"false\"" info "${info}")
    else()
      string(REPLACE "is_experimental = \"false\"" "is_experimental = \"true\"" info "${info}")
    endif()
    file(WRITE "${CAPABILITIES_INFO}.tmp" "${info}")
    file(RENAME "${CAPABILITIES_INFO}.tmp" "${CAPABILITIES_INFO}")
  endif()
endif()
