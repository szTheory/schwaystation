# include(inventory.cmake); schway_inventory_union(<selection.txt> <tests dir> <out var>)
# Fault prevented: a test listed in no directory, in two, or in an unsorted
# list, so the exact-inventory checks compare against the wrong set.
function(schway_inventory_union selection tests_dir out)
  if(NOT EXISTS "${selection}")
    message(FATAL_ERROR "inventory: selection ${selection} does not exist")
  endif()
  file(STRINGS "${selection}" dirs REGEX "^[^#]")
  set(all "")
  set(names "")
  foreach(dir IN LISTS dirs)
    string(STRIP "${dir}" dir)
    set(file "${tests_dir}/${dir}/inventory.txt")
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "inventory: ${selection} selects ${dir}, but ${file} does not exist")
    endif()
    file(STRINGS "${file}" lines REGEX "^[^#]")
    set(sorted ${lines})
    list(SORT sorted)
    if(NOT "${sorted}" STREQUAL "${lines}")
      message(FATAL_ERROR "inventory: ${file} is not sorted in byte order")
    endif()
    foreach(line IN LISTS lines)
      string(REGEX MATCH "^[^\t]+" name "${line}")
      if(name IN_LIST names)
        message(FATAL_ERROR "inventory: ${name} is listed twice in the directories ${selection} selects")
      endif()
      list(APPEND names "${name}")
    endforeach()
    list(APPEND all ${lines})
  endforeach()
  list(SORT all)
  set(${out} "${all}" PARENT_SCOPE)
endfunction()
