# cmake -DHEADER=<include/schwaystation.h> -DDOC=<docs/embedding.md> -P api_names.cmake
# Fault prevented: a public name hosts cannot find in the guide, or a guide naming a removed name. Every schway_ and
# SCHWAY_ name in the header must appear in the guide, and every one the guide writes must be declared; a guide name
# ending in _ (SCHWAY_STATUS_ERR_) must begin a declared name.
foreach(var HEADER DOC)
  if(NOT DEFINED ${var} OR NOT EXISTS "${${var}}")
    message(FATAL_ERROR "api_names: -D${var} must name an existing file")
  endif()
endforeach()

set(name_regex "schway_[a-z0-9_]+|SCHWAY_[A-Z0-9_]+")
file(READ "${HEADER}" header)
file(READ "${DOC}" doc)
string(REGEX MATCHALL "${name_regex}" declared "${header}")
string(REGEX MATCHALL "${name_regex}" written "${doc}")
list(REMOVE_DUPLICATES declared)
list(REMOVE_DUPLICATES written)
# A header name ending in _ is a comment's wildcard, not a name.
list(FILTER declared EXCLUDE REGEX "_$")

set(undocumented "")
foreach(name IN LISTS declared)
  if(NOT name IN_LIST written)
    list(APPEND undocumented ${name})
  endif()
endforeach()
set(unknown "")
foreach(name IN LISTS written)
  set(known FALSE)
  if(name IN_LIST declared)
    set(known TRUE)
  elseif(name MATCHES "_$")
    foreach(candidate IN LISTS declared)
      string(FIND "${candidate}" "${name}" at)
      if(at EQUAL 0)
        set(known TRUE)
      endif()
    endforeach()
  endif()
  if(NOT known)
    list(APPEND unknown ${name})
  endif()
endforeach()
set(problems "")
if(undocumented)
  string(APPEND problems "\n  api_names: undocumented: ${undocumented}")
endif()
if(unknown)
  string(APPEND problems "\n  api_names: not in the header: ${unknown}")
endif()
if(problems)
  message(FATAL_ERROR "${HEADER} against ${DOC}:${problems}")
endif()
list(LENGTH declared count)
message(STATUS "api_names: all ${count} public names appear in ${DOC}, and it names nothing undeclared")
