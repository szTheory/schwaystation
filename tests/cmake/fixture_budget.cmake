file(SIZE "${IMAGE}" image_size)
file(SIZE "${AUDIO}" audio_size)
math(EXPR disc_size "${image_size} + ${audio_size}")
if(disc_size GREATER 524288)
  message(FATAL_ERROR "fixture budget: disc is ${disc_size} bytes, cap is 524288")
endif()
file(SIZE "${EXE}" exe_size)
if(exe_size GREATER 65536)
  message(FATAL_ERROR "fixture budget: executable is ${exe_size} bytes, cap is 65536")
endif()
