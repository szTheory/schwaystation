cmake_minimum_required(VERSION 3.25)

if(NOT EXISTS "${QUALITY}" OR IS_DIRECTORY "${QUALITY}")
  message(FATAL_ERROR "quality: registry: -DQUALITY must name a readable registry file")
endif()
file(READ "${QUALITY}" registry)
set(metrics ir_per_frame.testcard ir_per_frame.gpu_motion size.wasm state.bytes ci.critical_path_s)

function(check_keys scope allowed)
  string(JSON kind ERROR_VARIABLE err TYPE "${registry}" ${ARGN})
  if(NOT err STREQUAL "NOTFOUND" OR NOT kind STREQUAL "OBJECT")
    message(FATAL_ERROR "quality: ${scope}: expected an object")
  endif()
  string(JSON count LENGTH "${registry}" ${ARGN})
  set(index 0)
  while(index LESS count)
    string(JSON name MEMBER "${registry}" ${ARGN} ${index})
    if(NOT name IN_LIST allowed)
      message(FATAL_ERROR "quality: ${scope}: unexpected key '${name}'")
    endif()
    math(EXPR index "${index} + 1")
  endwhile()
endfunction()

function(read_bound metric key out)
  string(JSON kind ERROR_VARIABLE err TYPE "${registry}" ${path} "${key}")
  if(NOT err STREQUAL "NOTFOUND")
    message(FATAL_ERROR "quality: ${metric}: ${key} is required for a bounded metric")
  endif()
  string(JSON value ERROR_VARIABLE err GET "${registry}" ${path} "${key}")
  if(NOT kind STREQUAL "NUMBER" OR NOT value MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "quality: ${metric}: ${key} must be a positive integer")
  endif()
  set("${out}" "${value}" PARENT_SCOPE)
endfunction()

# CMake's numeric comparisons use floating point. Compare decimal digits exactly.
function(greater left right out)
  string(LENGTH "${left}" left_length)
  string(LENGTH "${right}" right_length)
  if(left_length GREATER right_length OR (left_length EQUAL right_length AND left STRGREATER right))
    set("${out}" TRUE PARENT_SCOPE)
  else()
    set("${out}" FALSE PARENT_SCOPE)
  endif()
endfunction()

check_keys(registry "ir_per_frame;size;state;ci;reasons")
check_keys(ir_per_frame "testcard;gpu_motion" ir_per_frame)
check_keys(size wasm size)
check_keys(state bytes state)
check_keys(ci critical_path_s ci)
string(JSON reasons_kind ERROR_VARIABLE reasons_error TYPE "${registry}" reasons)
if(reasons_error STREQUAL "NOTFOUND")
  if(NOT reasons_kind STREQUAL "ARRAY")
    message(FATAL_ERROR "quality: registry: reasons must be a nonempty array of nonempty strings")
  endif()
  string(JSON reasons_count LENGTH "${registry}" reasons)
  if(reasons_count LESS 1)
    message(FATAL_ERROR "quality: registry: reasons must be a nonempty array of nonempty strings")
  endif()
  math(EXPR reasons_last "${reasons_count} - 1")
  foreach(index RANGE 0 ${reasons_last})
    string(JSON reason_kind ERROR_VARIABLE reason_error TYPE "${registry}" reasons ${index})
    string(JSON reason GET "${registry}" reasons ${index})
    string(STRIP "${reason}" reason)
    if(NOT reason_error STREQUAL "NOTFOUND" OR NOT reason_kind STREQUAL "STRING" OR reason STREQUAL "")
      message(FATAL_ERROR "quality: registry: reasons entries must be nonempty strings")
    endif()
  endforeach()
elseif(NOT reasons_error MATCHES "not found")
  message(FATAL_ERROR "quality: registry: invalid reasons array")
endif()
foreach(metric IN LISTS metrics)
  string(REPLACE "." ";" path "${metric}")
  set(allowed floor ceiling)
  if(metric STREQUAL "ci.critical_path_s")
    list(APPEND allowed workload_sha256)
  elseif(metric STREQUAL "size.wasm")
    list(APPEND allowed unbounded measurement)
  endif()
  check_keys("${metric}" "${allowed}" ${path})
  set(unbounded FALSE)
  if(metric STREQUAL "size.wasm")
    string(JSON unbounded_kind ERROR_VARIABLE unbounded_error TYPE "${registry}" ${path} unbounded)
    if(unbounded_error STREQUAL "NOTFOUND")
      string(JSON unbounded_value GET "${registry}" ${path} unbounded)
      string(JSON floor_kind ERROR_VARIABLE floor_error TYPE "${registry}" ${path} floor)
      string(JSON ceiling_kind ERROR_VARIABLE ceiling_error TYPE "${registry}" ${path} ceiling)
      if(NOT unbounded_kind STREQUAL "BOOLEAN" OR NOT unbounded_value OR
         floor_error STREQUAL "NOTFOUND" OR ceiling_error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "quality: ${metric}: unbounded must be true and cannot include floor or ceiling")
      endif()
      string(JSON measurement_kind ERROR_VARIABLE measurement_error TYPE "${registry}" ${path} measurement)
      if(measurement_error STREQUAL "NOTFOUND")
        string(JSON measurement_value GET "${registry}" ${path} measurement)
        if(NOT measurement_kind STREQUAL "NUMBER" OR NOT measurement_value MATCHES "^[1-9][0-9]*$")
          message(FATAL_ERROR "quality: ${metric}: measurement must be a positive integer")
        endif()
      elseif(NOT measurement_error MATCHES "not found")
        message(FATAL_ERROR "quality: ${metric}: invalid measurement")
      endif()
      set(unbounded TRUE)
    elseif(NOT unbounded_error MATCHES "not found")
      message(FATAL_ERROR "quality: ${metric}: unbounded must be true")
    endif()
  endif()
  if(unbounded)
    set(floor "")
    set(ceiling "")
  else()
    read_bound("${metric}" floor floor)
    read_bound("${metric}" ceiling ceiling)
    greater("${floor}" "${ceiling}" inverted)
    if(inverted)
      message(FATAL_ERROR "quality: ${metric}: floor exceeds ceiling")
    endif()
  endif()
  if(metric STREQUAL "ci.critical_path_s")
    string(JSON kind ERROR_VARIABLE err TYPE "${registry}" ${path} workload_sha256)
    if(err STREQUAL "NOTFOUND")
      string(JSON hash GET "${registry}" ${path} workload_sha256)
      string(LENGTH "${hash}" length)
      if(NOT kind STREQUAL "STRING" OR NOT length EQUAL 64 OR NOT hash MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "quality: ${metric}: workload_sha256 must be 64 lowercase hex digits")
      endif()
    endif()
  endif()
  if(metric STREQUAL METRIC)
    set(selected_floor "${floor}")
    set(selected_ceiling "${ceiling}")
    set(selected_unbounded "${unbounded}")
  endif()
endforeach()

if(NOT DEFINED METRIC AND NOT DEFINED MEASURED AND NOT DEFINED ARTIFACT)
  return()
endif()
if(NOT METRIC IN_LIST metrics)
  message(FATAL_ERROR "quality: registry: a supported -DMETRIC is required ('${METRIC}')")
endif()
if(DEFINED ARTIFACT)
  if(NOT METRIC STREQUAL "size.wasm" OR DEFINED MEASURED OR NOT EXISTS "${ARTIFACT}"
     OR IS_DIRECTORY "${ARTIFACT}" OR IS_SYMLINK "${ARTIFACT}")
    message(FATAL_ERROR "quality: ${METRIC}: artifact must be a regular file and the only size measurement")
  endif()
  file(SIZE "${ARTIFACT}" MEASURED)
  file(READ "${ARTIFACT}" wasm_magic LIMIT 4 HEX)
  if(NOT wasm_magic STREQUAL "0061736d")
    message(FATAL_ERROR "quality: ${METRIC}: artifact is not a WebAssembly module")
  endif()
endif()
if(NOT MEASURED MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "quality: ${METRIC}: measurement must be a positive integer")
endif()
if(selected_unbounded)
  message(STATUS "quality: ${METRIC}: measured ${MEASURED}; no bound is available yet")
  return()
endif()
greater("${selected_floor}" "${MEASURED}" below_floor)
greater("${MEASURED}" "${selected_ceiling}" above_ceiling)
if(below_floor)
  message(FATAL_ERROR "quality: ${METRIC}: measured ${MEASURED} is below floor ${selected_floor}")
elseif(above_ceiling)
  message(FATAL_ERROR "quality: ${METRIC}: measured ${MEASURED} is above ceiling ${selected_ceiling}")
endif()
