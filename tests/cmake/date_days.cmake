# Shared YYYY-MM-DD conversion for gates with distinct calendar policies.
function(schway_date_days out date failure_function strict_calendar)
  if(NOT "${date}" MATCHES "^([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
    if("${failure_function}" STREQUAL "perf_error")
      cmake_language(CALL "${failure_function}" "date '${date}' is not YYYY-MM-DD")
    else()
      cmake_language(CALL "${failure_function}" "invalid date '${date}'")
    endif()
  endif()
  math(EXPR y "1${CMAKE_MATCH_1}-10000")
  math(EXPR m "1${CMAKE_MATCH_2}-100")
  math(EXPR d "1${CMAKE_MATCH_3}-100")
  if(m LESS 1 OR m GREATER 12 OR d LESS 1 OR d GREATER 31)
    cmake_language(CALL "${failure_function}" "date out of range '${date}'")
  endif()
  if(strict_calendar)
    set(month_days 31 28 31 30 31 30 31 31 30 31 30 31)
    math(EXPR month_index "${m}-1")
    list(GET month_days ${month_index} month_limit)
    if(m EQUAL 2)
      math(EXPR leap "(${y}+4000)/4-(${y}+3999)/4-(${y}+4000)/100+(${y}+3999)/100+(${y}+4000)/400-(${y}+3999)/400")
      if(leap)
        set(month_limit 29)
      endif()
    endif()
    if(d GREATER month_limit)
      cmake_language(CALL "${failure_function}" "date out of range '${date}'")
    endif()
  endif()
  if(m LESS_EQUAL 2)
    math(EXPR y "${y}-1")
    math(EXPR m "${m}+9")
  else()
    math(EXPR m "${m}-3")
  endif()
  math(EXPR era "${y}/400")
  math(EXPR yoe "${y}-${era}*400")
  math(EXPR doy "(153*${m}+2)/5+${d}-1")
  math(EXPR days "${era}*146097+${yoe}*365+${yoe}/4-${yoe}/100+${doy}-719468")
  set(${out} "${days}" PARENT_SCOPE)
endfunction()
