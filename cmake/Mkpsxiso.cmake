# Build-only mkpsxiso v2.30 and only the four gitlinks needed by its ISO target.
if(CMAKE_SCRIPT_MODE_FILE)
  get_filename_component(schway__project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
else()
  set(schway__project_root "${PROJECT_SOURCE_DIR}")
endif()
if(CMAKE_SCRIPT_MODE_FILE AND DEFINED INPUT)
  if(NOT EXISTS "${INPUT}" OR NOT DEFINED SHA256)
    message(FATAL_ERROR "mkpsxiso pin check needs INPUT and SHA256")
  endif()
  file(SHA256 "${INPUT}" actual)
  if(NOT actual STREQUAL "${SHA256}")
    message(FATAL_ERROR "mkpsxiso: archive SHA-256 mismatch")
  endif()
  message(STATUS "mkpsxiso: archive SHA-256 matches")
  return()
endif()

function(schway__mkpsxiso_fetch name marker destination)
  file(STRINGS "${schway__project_root}/pins.txt" rows REGEX "^${name} ")
  list(LENGTH rows count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "mkpsxiso: pins.txt needs exactly one '${name}' row")
  endif()
  string(REPLACE " " ";" row "${rows}")
  list(GET row 2 url)
  list(GET row 3 sha256)
  set(pin_root "${PROJECT_BINARY_DIR}/pins/mkpsxiso")
  file(MAKE_DIRECTORY "${pin_root}")
  set(archive "${pin_root}/${name}.tar.gz")
  set(have FALSE)
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
    if(actual STREQUAL sha256)
      set(have TRUE)
    endif()
  endif()
  if(NOT have)
    file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH SHA256=${sha256} STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      file(REMOVE "${archive}")
      message(FATAL_ERROR "mkpsxiso: ${name} download or digest check failed: ${status}")
    endif()
  endif()
  file(SHA256 "${archive}" archive_sha256)
  set(extracted_pin "${destination}/.schwaystation-pin-sha256")
  set(needs_extract TRUE)
  if(EXISTS "${destination}/${marker}" AND EXISTS "${extracted_pin}")
    file(READ "${extracted_pin}" extracted_sha256)
    string(STRIP "${extracted_sha256}" extracted_sha256)
    if(extracted_sha256 STREQUAL archive_sha256)
      set(needs_extract FALSE)
    endif()
  endif()
  if(needs_extract)
    set(unpack "${pin_root}/${name}-unpack")
    file(REMOVE_RECURSE "${unpack}" "${destination}")
    file(MAKE_DIRECTORY "${unpack}" "${destination}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpack}")
    file(GLOB roots LIST_DIRECTORIES TRUE "${unpack}/*")
    list(LENGTH roots root_count)
    if(NOT root_count EQUAL 1)
      message(FATAL_ERROR "mkpsxiso: ${name} archive has an unexpected root layout")
    endif()
    list(GET roots 0 root)
    file(COPY "${root}/" DESTINATION "${destination}")
    file(WRITE "${extracted_pin}" "${archive_sha256}\n")
  endif()
endfunction()

schway__mkpsxiso_fetch(mkpsxiso CMakeLists.txt "${PROJECT_BINARY_DIR}/pins/mkpsxiso/source")
set(schway__mkpsxiso_source "${PROJECT_BINARY_DIR}/pins/mkpsxiso/source")
schway__mkpsxiso_fetch(mkpsxiso-tinyxml2 tinyxml2.cpp "${schway__mkpsxiso_source}/tinyxml2")
schway__mkpsxiso_fetch(mkpsxiso-miniaudio miniaudio.h "${schway__mkpsxiso_source}/miniaudio")
schway__mkpsxiso_fetch(mkpsxiso-filesystem include/ghc/filesystem.hpp "${schway__mkpsxiso_source}/ghc")
schway__mkpsxiso_fetch(mkpsxiso-threadpool ThreadPool.h "${schway__mkpsxiso_source}/threadpool")

include(ExternalProject)
set(schway__mkpsxiso_bin "${PROJECT_BINARY_DIR}/mkpsxiso-build")
if(WIN32)
  set(SCHWAYSTATION_MKPSXISO "${schway__mkpsxiso_bin}/mkpsxiso.exe")
else()
  set(SCHWAYSTATION_MKPSXISO "${schway__mkpsxiso_bin}/mkpsxiso")
endif()
ExternalProject_Add(schwaystation-mkpsxiso
  SOURCE_DIR "${schway__mkpsxiso_source}"
  BINARY_DIR "${schway__mkpsxiso_bin}"
  PREFIX "${PROJECT_BINARY_DIR}/mkpsxiso-ep"
  CMAKE_ARGS
    "-DCMAKE_BUILD_TYPE=Release"
    -DMKPSXISO_NO_LIBFLAC=ON
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --config Release --target mkpsxiso --parallel 2
  INSTALL_COMMAND ""
  BUILD_BYPRODUCTS "${SCHWAYSTATION_MKPSXISO}"
  LOG_CONFIGURE ON LOG_BUILD ON)
