# cmake -DOPENBIOS_INPUT=<path> [-DEXPECTED_FILE=<path>] -P OpenBIOS.cmake
# Fault prevented: an unexpected or corrupted OpenBIOS build entering CI.
if(NOT DEFINED OPENBIOS_INPUT OR "${OPENBIOS_INPUT}" STREQUAL "")
  message(FATAL_ERROR "OpenBIOS: OPENBIOS_INPUT is required")
endif()
if(NOT EXISTS "${OPENBIOS_INPUT}" OR IS_DIRECTORY "${OPENBIOS_INPUT}")
  message(FATAL_ERROR "OpenBIOS: input is missing or not a file")
endif()

file(SIZE "${OPENBIOS_INPUT}" size)
if(NOT size EQUAL 524288)
  message(FATAL_ERROR "OpenBIOS: expected 524288 bytes, got ${size}")
endif()
file(SHA256 "${OPENBIOS_INPUT}" actual)
message(STATUS "OpenBIOS output: ${size} bytes, SHA256=${actual}")

if(DEFINED EXPECTED_FILE)
  if(NOT EXISTS "${EXPECTED_FILE}" OR IS_DIRECTORY "${EXPECTED_FILE}")
    message(FATAL_ERROR "OpenBIOS: expected digest file is missing")
  endif()
  file(READ "${EXPECTED_FILE}" expected)
  string(STRIP "${expected}" expected)
  string(LENGTH "${expected}" expected_length)
  if(NOT expected_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "OpenBIOS: expected digest must be one lowercase SHA256")
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "OpenBIOS SHA256 mismatch: expected ${expected}, got ${actual}")
  endif()
endif()
