# The CHD reader is optional and host-only. Keep its fetched source out of the
# repository and verify the complete archive before extracting it.
file(STRINGS "${PROJECT_SOURCE_DIR}/pins.txt" schway__libchdr_rows REGEX "^libchdr ")
list(LENGTH schway__libchdr_rows schway__libchdr_count)
if(NOT schway__libchdr_count EQUAL 1)
  message(FATAL_ERROR "libchdr: pins.txt needs exactly one libchdr row")
endif()
string(REPLACE " " ";" schway__libchdr_row "${schway__libchdr_rows}")
list(GET schway__libchdr_row 1 schway__libchdr_commit)
list(GET schway__libchdr_row 2 schway__libchdr_url)
list(GET schway__libchdr_row 3 schway__libchdr_sha256)
if(NOT schway__libchdr_commit STREQUAL "47d794151b2b64f6aba60304e6480f4f5a2bc24b"
    OR NOT schway__libchdr_url MATCHES "/${schway__libchdr_commit}$")
  message(FATAL_ERROR "libchdr: pin URL or commit does not match the approved source")
endif()

set(schway__libchdr_root "${PROJECT_BINARY_DIR}/pins/libchdr")
file(MAKE_DIRECTORY "${schway__libchdr_root}")
set(schway__libchdr_archive "${schway__libchdr_root}/source.tar.gz")
set(schway__libchdr_valid FALSE)
if(EXISTS "${schway__libchdr_archive}")
  file(SHA256 "${schway__libchdr_archive}" schway__libchdr_actual)
  if(schway__libchdr_actual STREQUAL schway__libchdr_sha256)
    set(schway__libchdr_valid TRUE)
  endif()
endif()
if(NOT schway__libchdr_valid)
  file(DOWNLOAD "${schway__libchdr_url}" "${schway__libchdr_archive}"
    EXPECTED_HASH "SHA256=${schway__libchdr_sha256}" STATUS schway__libchdr_status)
  list(GET schway__libchdr_status 0 schway__libchdr_code)
  if(NOT schway__libchdr_code EQUAL 0)
    file(REMOVE "${schway__libchdr_archive}")
    message(FATAL_ERROR "libchdr: pinned archive download failed: ${schway__libchdr_status}")
  endif()
endif()

set(schway__libchdr_extract "${schway__libchdr_root}/source")
set(schway__libchdr_source_pin "${schway__libchdr_root}/source-pin-sha256")
file(GLOB schway__libchdr_roots LIST_DIRECTORIES TRUE "${schway__libchdr_extract}/*-libchdr-*")
set(schway__libchdr_source_valid FALSE)
if(EXISTS "${schway__libchdr_source_pin}")
  file(READ "${schway__libchdr_source_pin}" schway__libchdr_extracted_hash)
  string(STRIP "${schway__libchdr_extracted_hash}" schway__libchdr_extracted_hash)
  list(LENGTH schway__libchdr_roots schway__libchdr_root_count)
  if(schway__libchdr_extracted_hash STREQUAL schway__libchdr_sha256
      AND schway__libchdr_root_count EQUAL 1)
    list(GET schway__libchdr_roots 0 schway__libchdr_candidate)
    if(EXISTS "${schway__libchdr_candidate}/CMakeLists.txt"
        AND EXISTS "${schway__libchdr_candidate}/LICENSE.txt"
        AND EXISTS "${schway__libchdr_candidate}/include/libchdr/chd.h")
      set(schway__libchdr_source_valid TRUE)
      set(schway__libchdr_source "${schway__libchdr_candidate}")
    endif()
  endif()
endif()
if(NOT schway__libchdr_source_valid)
  file(REMOVE_RECURSE "${schway__libchdr_extract}" "${schway__libchdr_source_pin}")
  file(MAKE_DIRECTORY "${schway__libchdr_extract}")
  file(ARCHIVE_EXTRACT INPUT "${schway__libchdr_archive}" DESTINATION "${schway__libchdr_extract}")
  file(GLOB schway__libchdr_roots LIST_DIRECTORIES TRUE "${schway__libchdr_extract}/*-libchdr-*")
  list(LENGTH schway__libchdr_roots schway__libchdr_root_count)
  if(NOT schway__libchdr_root_count EQUAL 1)
    message(FATAL_ERROR "libchdr: pinned archive has an unexpected root layout")
  endif()
  list(GET schway__libchdr_roots 0 schway__libchdr_source)
  if(NOT EXISTS "${schway__libchdr_source}/CMakeLists.txt"
      OR NOT EXISTS "${schway__libchdr_source}/LICENSE.txt"
      OR NOT EXISTS "${schway__libchdr_source}/include/libchdr/chd.h")
    message(FATAL_ERROR "libchdr: pinned archive is missing required source or license files")
  endif()
  file(WRITE "${schway__libchdr_source_pin}" "${schway__libchdr_sha256}\n")
endif()

# Force the audited cache settings because the pinned project declares CMake
# 3.10 policies, where option() clears a normal variable. These values are
# part of this opt-in dependency closure, not user-selectable codec switches.
set(BUILD_SHARED_LIBS OFF)
set(INSTALL_STATIC_LIBS OFF CACHE BOOL "" FORCE)
set(WITH_SYSTEM_ZLIB OFF CACHE BOOL "" FORCE)
set(WITH_SYSTEM_ZSTD OFF CACHE BOOL "" FORCE)
set(CHDR_WANT_RAW_DATA_SECTOR ON CACHE BOOL "" FORCE)
set(CHDR_WANT_SUBCODE ON CACHE BOOL "" FORCE)
set(CHDR_VERIFY_BLOCK_CRC ON CACHE BOOL "" FORCE)
set(CHDR_WANT_TESTS OFF CACHE BOOL "" FORCE)
set(CHDR_FLAC_BACKEND drflac CACHE STRING "" FORCE)
set(CHDR_MICROFLAC_SOURCE_DIR "" CACHE PATH "" FORCE)
set(CHDR_MICROFLAC_GIT_TAG "" CACHE STRING "" FORCE)
set(WITH_LZMA_ASM OFF CACHE BOOL "" FORCE)
add_subdirectory("${schway__libchdr_source}" "${schway__libchdr_root}/build" EXCLUDE_FROM_ALL)
# The host disc-image library feeds shared modules only when libretro is built.
if(SCHWAYSTATION_BUILD_LIBRETRO)
  set_target_properties(chdr-static PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
